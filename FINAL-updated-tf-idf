ess = psutil.Process(os.getpid())\n\n# ============================================================\n# REPRODUCIBILITY\n# ============================================================\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\n\n# ============================================================\n# LOAD DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/input/datasets/raiantasnim/augmented/train_f15.csv\")\nval_df   = pd.read_csv(\"/kaggle/input/datasets/raiantasnim/augmented/val_f15.csv\")\ntest_df  = pd.read_csv(\"/kaggle/input/datasets/raiantasnim/augmented/test_f15.csv\")\n\nTEXT_COL = \"text\"\nLABEL_COL = \"label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# TF-IDF VECTORIZE\n# ============================================================\ntfidf = TfidfVectorizer(max_features=5000)\n\nX_train = tfidf.fit_transform(train_df[TEXT_COL]).toarray()\nX_val   = tfidf.transform(val_df[TEXT_COL]).toarray()\nX_test  = tfidf.transform(test_df[TEXT_COL]).toarray()\n\nINPUT_DIM = X_train.shape[1]\n\n# ============================================================\n# LABEL ENCODING\n# ============================================================\nle = LabelEncoder()\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nclass_names = le.classes_\n\n# ============================================================\n# DATASET\n# ============================================================\nclass TFIDFDataset(Dataset):\n    def __init__(self, X, y):\n        self.X = torch.tensor(X, dtype=torch.float32)\n        self.y = torch.tensor(y.values, dtype=torch.long)\n\n    def __len__(self):\n        return len(self.y)\n\n    def __getitem__(self, idx):\n        return {\n            \"input\": self.X[idx],\n            \"label\": self.y[idx]\n        }\n\ntrain_loader = DataLoader(TFIDFDataset(X_train, train_df[\"label_id\"]), batch_size=32, shuffle=True)\nval_loader   = DataLoader(TFIDFDataset(X_val, val_df[\"label_id\"]), batch_size=32, shuffle=False)\ntest_loader  = DataLoader(TFIDFDataset(X_test, test_df[\"label_id\"]), batch_size=32, shuffle=False)\n\n# ============================================================\n# MODEL: TF-IDF + RNN\n# ============================================================\nclass TFIDF_RNN(nn.Module):\n    def __init__(self):\n        super().__init__()\n\n        self.rnn = nn.RNN(\n            input_size=INPUT_DIM,\n            hidden_size=256,\n            num_layers=2,\n            batch_first=True,\n            nonlinearity='tanh'\n        )\n\n        self.dropout = nn.Dropout(0.4)\n        self.fc = nn.Linear(256, num_classes)\n\n    def forward(self, x):\n\n        x = x.unsqueeze(1)\n\n        out, _ = self.rnn(x)\n        x = out[:, -1, :]\n\n        x = self.dropout(x)\n        return self.fc(x)\n\nmodel = TFIDF_RNN().to(device)\n\n# ============================================================\n# LOSS + OPTIMIZER\n# ============================================================\ncriterion = nn.CrossEntropyLoss(label_smoothing=0.1)\noptimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n\n\n# ============================================================\n# EVALUATION\n# ============================================================\ndef evaluate(loader):\n    model.eval()\n\n    preds, labels, probs = [], [], []\n    total_loss = 0\n\n  \n    start_inference = time.time()\n    total_samples = 0\n\n    with torch.no_grad():\n        for batch in loader:\n\n            x = batch[\"input\"].to(device)\n            y = batch[\"label\"].to(device)\n\n            logits = model(x)\n\n            loss = criterion(logits, y)\n            total_loss += loss.item()\n\n            prob = torch.softmax(logits, dim=1)\n\n            preds.extend(torch.argmax(logits, dim=1).cpu().numpy())\n            labels.extend(y.cpu().numpy())\n            probs.extend(prob.cpu().numpy())\n\n            total_samples += x.size(0)\n\n    total_inference_time = time.time() - start_inference\n    avg_inference_time = (total_inference_time / total_samples) * 1000\n\n    acc = accuracy_score(labels, preds)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(\n        labels,\n        preds,\n        average=\"weighted\"\n    )\n\n    y_bin = label_binarize(\n        labels,\n        classes=list(range(num_classes))\n    )\n\n    auc = roc_auc_score(\n        y_bin,\n        np.array(probs),\n        average=\"weighted\",\n        multi_class=\"ovr\"\n    )\n\n    return (\n        acc,\n        pr,\n        rc,\n        f1,\n        auc,\n        total_loss / len(loader),\n        preds,\n        labels,\n        avg_inference_time,\n        total_inference_time\n    )\n\n# ============================================================\n# TRAINING\n# ============================================================\nEPOCHS = 15\nbest_val_loss = float(\"inf\")\nbest_state = None\nPATIENCE = 3\ncounter = 0\n\nstart_time = time.time()\n\nfor epoch in range(EPOCHS):\n    model.train()\n    total_loss = 0\n\n    for batch in train_loader:\n        optimizer.zero_grad()\n\n        x = batch[\"input\"].to(device)\n        y = batch[\"label\"].to(device)\n\n        logits = model(x)\n        loss = criterion(logits, y)\n\n        loss.backward()\n        optimizer.step()\n\n        total_loss += loss.item()\n\n    train_loss = total_loss / len(train_loader)\n\n    val_acc, val_pr, val_rc, val_f1, val_auc, val_loss, _, _, _, _ = evaluate(val_loader)\n\n    print(f\"Epoch {epoch+1}/{EPOCHS} | Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f} | Val Acc: {val_acc:.4f}\")\n\n    if val_loss < best_val_loss:\n        best_val_loss = val_loss\n        best_state = model.state_dict()\n        counter = 0\n    else:\n        counter += 1\n        if counter >= PATIENCE:\n            print(\"⛔ Early stopping triggered\")\n            break\n\nmodel.load_state_dict(best_state)\n\n# ============================================================\n# FINAL EVALUATION\n# ============================================================\ntr = evaluate(train_loader)\nva = evaluate(val_loader)\nte = evaluate(test_loader)\n\ntraining_time = time.time() - start_time\nram_used = process.memory_info().rss / (1024 * 1024)\n\n# ============================================================\n# PERFORMANCE TABLE\n# ============================================================\nresults = pd.DataFrame({\n\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n\n    \"Accuracy\": [tr[0], va[0], te[0]],\n\n    \"Precision\": [tr[1], va[1], te[1]],\n\n    \"Recall\": [tr[2], va[2], te[2]],\n\n    \"F1-score\": [tr[3], va[3], te[3]],\n\n    \"Loss\": [tr[5], va[5], te[5]],\n\n    \"AUC\": [tr[4], va[4], te[4]],\n\n    \"Inference Time per Sample (ms)\": [\n        tr[8],\n        va[8],\n        te[8]\n    ],\n\n    \"Total Inference Time (sec)\": [\n        tr[9],\n        va[9],\n        te[9]\n    ],\n\n    \"Training Time (sec)\": [training_time] * 3,\n\n    \"RAM Used (MB)\": [ram_used] * 3\n})\n\n# ============================================================\n# PRINT RESULTS\n# ============================================================\nprint(\"\\n===== FINAL PERFORMANCE TABLE =====\")\n\nprint(results.round(4))\n\nprint(\"\\n===== INFERENCE TIME =====\")\n\nprint(\n    f\"Train  - Total: {tr[9]:.4f} sec | \"\n    f\"Avg/sample: {tr[8]:.4f} ms\"\n)\n\nprint(\n    f\"Val    - Total: {va[9]:.4f} sec | \"\n    f\"Avg/sample: {va[8]:.4f} ms\"\n)\n\nprint(\n    f\"Test   - Total: {te[9]:.4f} sec | \"\n    f\"Avg/sample: {te[8]:.4f} ms\"\n)\n\n\n\n# ============================================================\n# PREDICTION FUNCTION\n# ============================================================\ndef predict_disease_terminal(text):\n    model.eval()\n\n    text = clean_text(text)\n\n  \n    vec = tfidf.transform([text]).toarray()\n    x = torch.tensor(vec, dtype=torch.float32).to(device)\n\n    with torch.no_grad():\n        logits = model(x)\n        probs = torch.softmax(logits, dim=1).cpu().numpy()[0]\n\n    df = pd.DataFrame({\n        \"Disease Name\": class_names,\n        \"Probability\": probs\n    }).sort_values(by=\"Probability\", ascending=False)\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"🩺 DISEASE PREDICTION RESULT\")\n    print(\"=\"*60)\n\n    print(\"\\n🔹 Input Symptoms:\")\n    print(text)\n\n    print(\"\\n🔹 Top Prediction:\")\n    print(df.iloc[0][\"Disease Name\"])\n    print(f\"Confidence: {df.iloc[0]['Probability']*100:.2f}%\")\n\n    return df\n\n# ============================================================\n# RUN SAMPLE PREDICTIONS (Test Set)\n# ============================================================\nsamples = [\n    \n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে। আমার বুকে মাঝে মাঝে সারা রাত ব্যথা হয়, এবং আমি মাঝে মাঝে অসুস্থ বোধ করি।\",\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে। এমন কিছু অঞ্চলও রয়েছে যেগুলি আমার ত্বকের বাকি অংশের চেয়ে বেশি গাঢ় রঙের, এবং আমার কিছু বেদনাদায়ক পিণ্ড রয়েছে।\",\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না। আমার বুকে ব্যাথা হয় এবং আমার হৃদয় মনে হয় যেন আমি কাশির সময় ঘন্টায় এক মিলিয়ন মাইল বেগে দৌড়াচ্ছে। আমি একটি খারাপ মরিচা কফ আউট কাশি করছি.\",\n    