=================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# TF-IDF VECTORIZE\n# ============================================================\ntfidf = TfidfVectorizer(\n    max_features=7000,\n    ngram_range=(1,2),\n    sublinear_tf=True\n)\n\nX_train = tfidf.fit_transform(train_df[TEXT_COL]).toarray()\nX_val   = tfidf.transform(val_df[TEXT_COL]).toarray()\nX_test  = tfidf.transform(test_df[TEXT_COL]).toarray()\n\nINPUT_DIM = X_train.shape[1]\n\n# ============================================================\n# LABEL ENCODING\n# ============================================================\nle = LabelEncoder()\n\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nclass_names = le.classes_\n\n# ============================================================\n# DATASET\n# ============================================================\nclass TFIDFDataset(Dataset):\n\n    def __init__(self, X, y):\n        self.X = torch.tensor(X, dtype=torch.float32)\n        self.y = torch.tensor(y.values, dtype=torch.long)\n\n    def __len__(self):\n        return len(self.y)\n\n    def __getitem__(self, idx):\n        return {\n            \"input\": self.X[idx],\n            \"label\": self.y[idx]\n        }\n\ntrain_loader = DataLoader(\n    TFIDFDataset(X_train, train_df[\"label_id\"]),\n    batch_size=32,\n    shuffle=True\n)\n\nval_loader = DataLoader(\n    TFIDFDataset(X_val, val_df[\"label_id\"]),\n    batch_size=32,\n    shuffle=False\n)\n\ntest_loader = DataLoader(\n    TFIDFDataset(X_test, test_df[\"label_id\"]),\n    batch_size=32,\n    shuffle=False\n)\n\n# ============================================================\n# MODEL: TF-IDF + GRU\n# ============================================================\nclass TFIDF_GRU(nn.Module):\n\n    def __init__(self):\n        super().__init__()\n\n        self.gru = nn.GRU(\n            input_size=INPUT_DIM,\n            hidden_size=256,\n            num_layers=2,\n            batch_first=True,\n            dropout=0.3,\n            bidirectional=True\n        )\n\n        self.dropout = nn.Dropout(0.5)\n\n        self.fc1 = nn.Linear(256 * 2, 128)\n        self.relu = nn.ReLU()\n\n        self.fc2 = nn.Linear(128, num_classes)\n\n    def forward(self, x):\n\n        # [batch, features] -> [batch, seq_len=1, features]\n        x = x.unsqueeze(1)\n\n        out, _ = self.gru(x)\n\n        # Last timestep output\n        x = out[:, -1, :]\n\n        x = self.dropout(x)\n\n        x = self.fc1(x)\n        x = self.relu(x)\n\n        x = self.dropout(x)\n\n        x = self.fc2(x)\n\n        return x\n\nmodel = TFIDF_GRU().to(device)\n\n# ============================================================\n# LOSS + OPTIMIZER\n# ============================================================\ncriterion = nn.CrossEntropyLoss(label_smoothing=0.05)\n\noptimizer = torch.optim.AdamW(\n    model.parameters(),\n    lr=1e-3,\n    weight_decay=1e-4\n)\n\nscheduler = torch.optim.lr_scheduler.ReduceLROnPlateau(\n    optimizer,\n    mode='min',\n    factor=0.5,\n    patience=1\n)\n\n# ============================================================\n# EVALUATION\n# ============================================================\ndef evaluate(loader):\n\n    model.eval()\n\n    preds, labels, probs = [], [], []\n\n    total_loss = 0\n\n    start_inference = time.time()\n    total_samples = 0\n\n    with torch.no_grad():\n\n        for batch in loader:\n\n            x = batch[\"input\"].to(device)\n            y = batch[\"label\"].to(device)\n\n            logits = model(x)\n\n            loss = criterion(logits, y)\n\n            total_loss += loss.item()\n\n            prob = torch.softmax(logits, dim=1)\n\n            preds.extend(torch.argmax(logits, dim=1).cpu().numpy())\n            labels.extend(y.cpu().numpy())\n            probs.extend(prob.cpu().numpy())\n\n            total_samples += x.size(0)\n\n    total_inference_time = time.time() - start_inference\n\n    avg_inference_time = (\n        total_inference_time / total_samples\n    ) * 1000\n\n    acc = accuracy_score(labels, preds)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(\n        labels,\n        preds,\n        average=\"weighted\"\n    )\n\n    y_bin = label_binarize(\n        labels,\n        classes=list(range(num_classes))\n    )\n\n    auc = roc_auc_score(\n        y_bin,\n        np.array(probs),\n        average=\"weighted\",\n        multi_class=\"ovr\"\n    )\n\n    return (\n        acc,\n        pr,\n        rc,\n        f1,\n        auc,\n        total_loss / len(loader),\n        preds,\n        labels,\n        avg_inference_time,\n        total_inference_time\n    )\n\n# ============================================================\n# TRAINING\n# ============================================================\nEPOCHS = 15\n\nbest_val_loss = float(\"inf\")\nbest_state = None\n\nPATIENCE = 4\ncounter = 0\n\nstart_time = time.time()\n\nfor epoch in range(EPOCHS):\n\n    model.train()\n\n    total_loss = 0\n\n    for batch in train_loader:\n\n        optimizer.zero_grad()\n\n        x = batch[\"input\"].to(device)\n        y = batch[\"label\"].to(device)\n\n        logits = model(x)\n\n        loss = criterion(logits, y)\n\n        loss.backward()\n\n        torch.nn.utils.clip_grad_norm_(\n            model.parameters(),\n            max_norm=1.0\n        )\n\n        optimizer.step()\n\n        total_loss += loss.item()\n\n    train_loss = total_loss / len(train_loader)\n\n    val_acc, val_pr, val_rc, val_f1, val_auc, val_loss, _, _, _, _ = evaluate(val_loader)\n\n    scheduler.step(val_loss)\n\n    print(\n        f\"Epoch {epoch+1}/{EPOCHS} | \"\n        f\"Train Loss: {train_loss:.4f} | \"\n        f\"Val Loss: {val_loss:.4f} | \"\n        f\"Val Acc: {val_acc:.4f}\"\n    )\n\n    if val_loss < best_val_loss:\n\n        best_val_loss = val_loss\n        best_state = model.state_dict()\n\n        counter = 0\n\n    else:\n\n        counter += 1\n\n        if counter >= PATIENCE:\n            print(\"⛔ Early stopping triggered\")\n            break\n\nmodel.load_state_dict(best_state)\n\n# ============================================================\n# FINAL EVALUATION\n# ============================================================\ntr = evaluate(train_loader)\nva = evaluate(val_loader)\nte = evaluate(test_loader)\n\ntraining_time = time.time() - start_time\n\nram_used = process.memory_info().rss / (1024 * 1024)\n\n# ============================================================\n# PERFORMANCE TABLE\n# ============================================================\nresults = pd.DataFrame({\n\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n\n    \"Accuracy\": [tr[0], va[0], te[0]],\n\n    \"Precision\": [tr[1], va[1], te[1]],\n\n    \"Recall\": [tr[2], va[2], te[2]],\n\n    \"F1-score\": [tr[3], va[3], te[3]],\n\n    \"Loss\": [tr[5], va[5], te[5]],\n\n    \"AUC\": [tr[4], va[4], te[4]],\n\n    \"Inference Time per Sample (ms)\": [\n        tr[8],\n        va[8],\n        te[8]\n    ],\n\n    \"Total Inference Time (sec)\": [\n        tr[9],\n        va[9],\n        te[9]\n    ],\n\n    \"Training Time (sec)\": [training_time] * 3,\n\n    \"RAM Used (MB)\": [ram_used] * 3\n})\n\n# ============================================================\n# PRINT RESULTS\n# ============================================================\nprint(\"\\n===== FINAL PERFORMANCE TABLE =====\")\n\nprint(results.round(4))\n\nprint(\"\\n===== INFERENCE TIME =====\")\n\nprint(\n    f\"Train  - Total: {tr[9]:.4f} sec | \"\n    f\"Avg/sample: {tr[8]:.4f} ms\"\n)\n\nprint(\n    f\"Val    - Total: {va[9]:.4f} sec | \"\n    f\"Avg/sample: {va[8]:.4f} ms\"\n)\n\nprint(\n    f\"Test   - Total: {te[9]:.4f} sec | \"\n    f\"Avg/sample: {te[8]:.4f} ms\"\n)\n\n# ============================================================\n# PREDICTION FUNCTION\n# ============================================================\ndef predict_disease_terminal(text):\n\n    model.eval()\n\n    text = clean_text(text)\n\n    vec = tfidf.transform([text]).toarray()\n\n    x = torch.tensor(\n        vec,\n        dtype=torch.float32\n    ).to(device)\n\n    with torch.no_grad():\n\n        logits = model(x)\n\n        probs = torch.softmax(\n            logits,\n            dim=1\n        ).cpu().numpy()[0]\n\n    df = pd.DataFrame({\n\n        \"Disease Name\": class_names,\n\n        \"Probability\": probs\n\n    }).sort_values(\n        by=\"Probability\",\n        ascending=False\n    )\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"🩺 DISEASE PREDICTION RESULT\")\n    print(\"=\"*60)\n\n    print(\"\\n🔹 Input Symptoms:\")\n    print(text)\n\n    print(\"\\n🔹 Top Prediction:\")\n    print(df.iloc[0][\"Disease Name\"])\n\n    print(\n        f\"Confidence: \"\n        f\"{df.iloc[0]['Probability']*100:.2f}%\"\n    )\n\n    return df\n\n# ============================================================\n# SAMPLE PREDICTIONS\n# ============================================================\nsamples = [\n\n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে।\",\n\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে।\",\n\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না।\"\n]\n\nfor s in samples:\n    predict_disease_terminal(s)\n\n# ===============================================