==========================================\nimport pandas as pd\nimport numpy as np\nimport re\nimport torch\nimport torch.nn as nn\nimport warnings\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport time\nimport psutil\nimport os\nimport random\n\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.preprocessing import LabelEncoder, label_binarize\nfrom sklearn.metrics import accuracy_score, precision_recall_fscore_support\nfrom sklearn.metrics import roc_auc_score, confusion_matrix\nfrom torch.utils.data import Dataset, DataLoader\n\nwarnings.filterwarnings(\"ignore\")\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# REPRODUCIBILITY\n# ============================================================\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\n\n# ============================================================\n# LOAD DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/input/datasets/raiantasnim/augmented/train_f15.csv\")\nval_df   = pd.read_csv(\"/kaggle/input/datasets/raiantasnim/augmented/val_f15.csv\")\ntest_df  = pd.read_csv(\"/kaggle/input/datasets/raiantasnim/augmented/test_f15.csv\")\n\nTEXT_COL = \"text\"\nLABEL_COL = \"label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# TF-IDF\n# ============================================================\ntfidf = TfidfVectorizer(max_features=5000)\n\nX_train = tfidf.fit_transform(train_df[TEXT_COL]).toarray()\nX_val   = tfidf.transform(val_df[TEXT_COL]).toarray()\nX_test  = tfidf.transform(test_df[TEXT_COL]).toarray()\n\nINPUT_DIM = X_train.shape[1]\n\n# ============================================================\n# LABEL ENCODING\n# ============================================================\nle = LabelEncoder()\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nclass_names = le.classes_\n\n# ============================================================\n# DATASET\n# ============================================================\nclass TFIDFDataset(Dataset):\n    def __init__(self, X, y):\n        self.X = torch.tensor(X, dtype=torch.float32)\n        self.y = torch.tensor(y.values, dtype=torch.long)\n\n    def __len__(self):\n        return len(self.y)\n\n    def __getitem__(self, idx):\n        return {\"input\": self.X[idx], \"label\": self.y[idx]}\n\ntrain_loader = DataLoader(TFIDFDataset(X_train, train_df[\"label_id\"]), batch_size=32, shuffle=True)\nval_loader   = DataLoader(TFIDFDataset(X_val, val_df[\"label_id\"]), batch_size=32, shuffle=False)\ntest_loader  = DataLoader(TFIDFDataset(X_test, test_df[\"label_id\"]), batch_size=32, shuffle=False)\n\n# ============================================================\n# MODEL: TF-IDF + Bi-RNN\n# ============================================================\nclass TFIDF_BiRNN(nn.Module):\n    def __init__(self):\n        super().__init__()\n\n        self.hidden_size = 256\n\n        self.rnn = nn.RNN(\n            input_size=INPUT_DIM,\n            hidden_size=self.hidden_size,\n            num_layers=2,\n            batch_first=True,\n            nonlinearity='tanh',\n            bidirectional=True\n        )\n\n        self.dropout = nn.Dropout(0.4)\n\n        # BiRNN => hidden_size * 2\n        self.fc = nn.Linear(self.hidden_size * 2, num_classes)\n\n    def forward(self, x):\n\n        x = x.unsqueeze(1)   # (batch, seq=1, features)\n\n        out, _ = self.rnn(x)\n\n        x = out[:, -1, :]   # last timestep\n\n        x = self.dropout(x)\n\n        return self.fc(x)\n\nmodel = TFIDF_BiRNN().to(device)\n\n# ============================================================\n# LOSS + OPTIMIZER\n# ============================================================\ncriterion = nn.CrossEntropyLoss(label_smoothing=0.1)\noptimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n\n# ============================================================\n# EVALUATION FUNCTION\n# (same as your original)\n# ============================================================\ndef evaluate(loader):\n    model.eval()\n\n    preds, labels, probs = [], [], []\n    total_loss = 0\n\n    start = time.time()\n    total_samples = 0\n\n    with torch.no_grad():\n        for batch in loader:\n\n            x = batch[\"input\"].to(device)\n            y = batch[\"label\"].to(device)\n\n            logits = model(x)\n            loss = criterion(logits, y)\n            total_loss += loss.item()\n\n            prob = torch.softmax(logits, dim=1)\n\n            preds.extend(torch.argmax(logits, dim=1).cpu().numpy())\n            labels.extend(y.cpu().numpy())\n            probs.extend(prob.cpu().numpy())\n\n            total_samples += x.size(0)\n\n    total_time = time.time() - start\n    avg_time = (total_time / total_samples) * 1000\n\n    acc = accuracy_score(labels, preds)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(labels, preds, average=\"weighted\")\n\n    y_bin = label_binarize(labels, classes=list(range(num_classes)))\n\n    auc = roc_auc_score(y_bin, np.array(probs), average=\"weighted\", multi_class=\"ovr\")\n\n    return acc, pr, rc, f1, auc, total_loss / len(loader), preds, labels, avg_time, total_time\n\n# ============================================================\n# TRAINING\n# ============================================================\nEPOCHS = 15\nbest_loss = float(\"inf\")\nbest_state = None\npatience = 3\ncounter = 0\n\nstart_time = time.time()\n\nfor epoch in range(EPOCHS):\n    model.train()\n    total_loss = 0\n\n    for batch in train_loader:\n\n        optimizer.zero_grad()\n\n        x = batch[\"input\"].to(device)\n        y = batch[\"label\"].to(device)\n\n        logits = model(x)\n        loss = criterion(logits, y)\n\n        loss.backward()\n        optimizer.step()\n\n        total_loss += loss.item()\n\n    train_loss = total_loss / len(train_loader)\n\n    val_acc, val_pr, val_rc, val_f1, val_auc, val_loss, _, _, _, _ = evaluate(val_loader)\n\n    print(f\"Epoch {epoch+1}/{EPOCHS} | Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f} | Val Acc: {val_acc:.4f}\")\n\n    if val_loss < best_loss:\n        best_loss = val_loss\n        best_state = model.state_dict()\n        counter = 0\n    else:\n        counter += 1\n        if counter >= 3:\n            print(\"Early stopping triggered\")\n            break\n\nmodel.load_state_dict(best_state)\n\n# ============================================================\n# FINAL EVALUATION\n# ============================================================\ntr = evaluate(train_loader)\nva = evaluate(val_loader)\nte = evaluate(test_loader)\n\ntraining_time = time.time() - start_time\nram_used = process.memory_info().rss / (1024 * 1024)\n\n# ============================================================\n# RESULTS TABLE\n# ============================================================\nresults = pd.DataFrame({\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n    \"Accuracy\": [tr[0], va[0], te[0]],\n    \"Precision\": [tr[1], va[1], te[1]],\n    \"Recall\": [tr[2], va[2], te[2]],\n    \"F1-score\": [tr[3], va[3], te[3]],\n    \"AUC\": [tr[4], va[4], te[4]],\n    \"Loss\": [tr[5], va[5], te[5]],\n    \"Training Time 