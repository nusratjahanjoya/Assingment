      text,\n        padding=\"max_length\",\n        truncation=True,\n        max_length=MAX_LEN,\n        return_tensors=\"pt\"\n    )\n\n    with torch.no_grad():\n        outputs = model(\n            encoding[\"input_ids\"].to(device),\n            encoding[\"attention_mask\"].to(device)\n        )\n        probabilities = torch.softmax(outputs, dim=1).cpu().numpy()[0]\n\n    results_pred = pd.DataFrame({\n        \"Disease Name\": bangla_class_names,\n        \"Probability\": probabilities\n    }).sort_values(by=\"Probability\", ascending=False).reset_index(drop=True)\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"🩺 DISEASE PREDICTION RESULT\")\n    print(\"=\"*60)\n\n    print(\"\\n🔹 Input Symptoms:\")\n    print(text)\n\n    print(\"\\n🔹 Top Prediction:\")\n    print(f\"👉 {results_pred.iloc[0]['Disease Name']}\")\n    print(f\"🔥 Confidence: {results_pred.iloc[0]['Probability']*100:.2f}%\")\n\n    return results_pred\n\n# ============================================================\n# RUN SAMPLE PREDICTIONS (Test Set)\n# ============================================================\nsamples = [\n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে। আমার বুকে মাঝে মাঝে সারা রাত ব্যথা হয়, এবং আমি মাঝে মাঝে অসুস্থ বোধ করি।\",\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে। এমন কিছু অঞ্চলও রয়েছে যেগুলি আমার ত্বকের বাকি অংশের চেয়ে বেশি গাঢ় রঙের, এবং আমার কিছু বেদনাদায়ক পিণ্ড রয়েছে।\",\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না। আমার বুকে ব্যাথা হয় এবং আমার হৃদয় মনে হয় যেন আমি কাশির সময় ঘন্টায় এক মিলিয়ন মাইল বেগে দৌড়াচ্ছে। আমি একটি খারাপ মরিচা কফ আউট কাশি করছি.\",\n    \"আমি খুব বমি বমি ভাব অনুভব করি এবং বুকে ব্যথা অনুভব করি। সম্প্রতি আমি বুকে ব্যথা অনুভব করছি। আমি খুব অস্বস্তি বোধ করি এবং প্রায়শই প্রচুর ঘাম হয়\",\n    \"আমি যখন ঘুম থেকে উঠি তখন আমি প্রায়শই একটি খোঁচা কণ্ঠস্বর বা ব্যথাযুক্ত গলা পাই। আমার নিঃশ্বাসে দুর্গন্ধ এবং ক্রমাগত গলা ব