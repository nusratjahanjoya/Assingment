tlib seaborn psutil\n\n# ============================================================\n# IMPORTS\n# ============================================================\nimport pandas as pd\nimport numpy as np\nimport re\nimport torch\nimport torch.nn as nn\nimport warnings\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport time\nimport psutil\nimport os\nimport random\n\nfrom torch.utils.data import Dataset, DataLoader\nfrom transformers import AutoTokenizer, AutoModel\nfrom sklearn.preprocessing import LabelEncoder, label_binarize\nfrom sklearn.metrics import accuracy_score, precision_recall_fscore_support\nfrom sklearn.metrics import classification_report, roc_auc_score, confusion_matrix\n\nwarnings.filterwarnings(\"ignore\")\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# REPRODUCIBILITY\n# ============================================================\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\ntorch.cuda.manual_seed_all(SEED)\ntorch.backends.cudnn.deterministic = True\ntorch.backends.cudnn.benchmark = False\n\n# ============================================================\n# LOAD PRE-SPLIT DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/working/train_augmented_clean-333.csv\")\nval_df   = pd.read_csv(\"/kaggle/working/validation_clean-333.csv\")\ntest_df  = pd.read_csv(\"/kaggle/working/test_clean-333.csv\")\n\nTEXT_COL = \"Symptom_Description\"\nLABEL_COL = \"Disease_Label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# LABEL ENCODING (FIT ONLY ON TRAIN)\n# ============================================================\nle = LabelEncoder()\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nbangla_class_names = le.classes_\n\n# ============================================================\n# TOKENIZER\n# ============================================================\nMODEL_NAME = \"csebuetnlp/banglabert\"\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\nMAX_LEN = 128\n\n# ============================================================\n# DATASET CLASS\n# ============================================================\nclass BanglaDataset(Dataset):\n    def __init__(self, texts, labels):\n        self.texts = texts.tolist()\n        self.labels = labels.tolist()\n\n    def __len__(self):\n        return len(self.texts)\n\n    def __getitem__(self, idx):\n        enc = tokenizer(\n            self.texts[idx],\n            padding=\"max_length\",\n            truncation=True,\n            max_length=MAX_LEN,\n            return_tensors=\"pt\"\n        )\n\n        return {\n            \"input_ids\": enc[\"input_ids\"].squeeze(0),\n            \"attention_mask\": enc[\"attention_mask\"].squeeze(0),\n            \"labels\": torch.tensor(self.labels[idx], dtype=torch.long)\n        }\n\n# Train loader \ntrain_loader = DataLoader(\n    BanglaDataset(train_df[TEXT_COL], train_df[\"label_id\"]),\n    batch_size=32, shuffle=True\n)\n\n# Train evaluation \ntrain_eval_loader = DataLoader(\n    BanglaDataset(train_df[TEXT_COL], train_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\nval_loader = DataLoader(\n    BanglaDataset(val_df[TEXT_COL], val_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\ntest_loader = DataLoader(\n    BanglaDataset(test_df[TEXT_COL], test_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\n# ============================================================\n# MODEL\n# ============================================================\nclass BanglaBERT_Classifier(nn.Module):\n    def __init__(self, num_classes):\n        super().__init__()\n        self.bert = AutoModel.from_pretrained(MODEL_NAME)\n\n        for param in self.bert.parameters():\n            param.requires_grad = False\n\n        for name, param in self.bert.named_parameters():\n            if \"encoder.layer.10\" in name or \"encoder.layer.11\" in name:\n                param.requires_grad = True\n\n        self.dropout = nn.Dropout(0.4)\n        self.fc = nn.Linear(self.bert.config.hidden_size, num_classes)\n\n    def forward(self, input_ids, attention_mask):\n        outputs = self.bert(\n            input_ids=input_ids,\n            attention_mask=attention_mask\n        )\n        cls_output = outputs.last_hidden_state[:, 0, :]\n        x = self.dropout(cls_output)\n        return self.fc(x)\n\nmodel = BanglaBERT_Classifier(num_classes).to(device)\n\n# ============================================================\n# LOSS + OPTIMIZER\n# ============================================================\ncriterion = nn.CrossEntropyLoss(label_smoothing=0.1)\noptimizer = torch.optim.AdamW(model.parameters(), lr=2e-5, weight_decay=1e-3)\n\n\n# ============================================================\n# EVALUATION FUNCTION (ADD INFERENCE TIME)\n# ============================================================\n\ndef evaluate(loader):\n\n    model.eval()\n\n    preds, labels, probs = [], [], []\n    total_loss = 0\n\n    start_inf = time.time()\n\n    with torch.no_grad():\n\n        for batch in loader:\n\n            input_ids = batch[\"input_ids\"].to(device)\n            attention_mask = batch[\"attention_mask\"].to(device)\n            y = batch[\"labels\"].to(device)\n\n            logits = model(input_ids, attention_mask)\n\n            loss = criterion(logits, y)\n            total_loss += loss.item()\n\n            probabilities = torch.softmax(logits, dim=1)\n\n            probs.extend(probabilities.cpu().numpy())\n            preds.extend(torch.argmax(logits, dim=1).cpu().numpy())\n            labels.extend(y.cpu().numpy())\n\n    total_inference_time = time.time() - start_inf\n\n    avg_time_per_sample = (total_inference_time / len(labels)) * 1000  # ms\n\n    acc = accuracy_score(labels, preds)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(\n        labels, preds, average=\"weighted\"\n    )\n\n    y_bin = label_binarize(labels, classes=list(range(num_classes)))\n\n    auc = roc_auc_score(\n        y_bin,\n        np.array(probs),\n        average=\"weighted\",\n        multi_class=\"ovr\"\n    )\n\n    avg_loss = total_loss / len(loader)\n\n    return acc, pr, rc, f1, auc, avg_loss, preds, labels, avg_time_per_sample, total_inference_time\n    \n# ============================================================\n# TRAINING\n# ============================================================\nEPOCHS = 5\nbest_val_loss = float(\"inf\")\nbest_state = None\n\nstart_time = time.time()\n\nfor epoch in range(EPOCHS):\n    model.train()\n    total_loss = 0\n\n    for batch in train_loader:\n        optimizer.zero_grad()\n\n        input_ids = batch[\"input_ids\"].to(device)\n        attention_mask = batch[\"attention_mask\"].to(device)\n        labels = batch[\"labels\"].to(device)\n\n        logits = model(input_ids, attention_mask)\n        loss = criterion(logits, labels)\n        loss.backward()\n\n        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n        optimizer.step()\n\n        total_loss += loss.item()\n\n    train_loss = total_loss / len(train_loader)\n\n    val_acc, val_pr, val_rc, val_f1, val_auc, val_loss, _, _, _, _ = evaluate(val_loader)\n\n    print(f\"Epoch {epoch+1}/{EPOCHS} | \"\n          f\"Train Loss: {train_loss:.4f} | \"\n          f\"Val Loss: {val_loss:.4f} | \"\n          f\"Val Acc: {val_acc:.4f} | \"\n          f\"Val F1: {val_f1:.4f}\")\n\n    if val_loss < best_val_loss:\n        best_val_loss = val_loss\n        best_state = model.state_dict()\n\nif best_state:\n    model.load_state_dict(best_state)\n\ntraining_time = time.time() - start_time\nram_used = process.memory_info().rss / (1024 ** 2)\n\n# ============================================================\n# FINAL EVALUATION\n# ============================================================\ntr = evaluate(train_eval_loader)\nva = evaluate(val_loader)\nte = evaluate(test_loader)\n\n# ============================================================\n# PERFORMANCE TABLE\n# ============================================================\n\nresults = pd.DataFrame({\n\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n\n    \"Accuracy\": [tr[0], va[0], te[0]],\n    \"Precision\": [tr[1], va[1], te[1]],\n    \"Recall\": [tr[2], va[2], te[2]],\n    \"F1-score\": [tr[3], va[3], te[3]],\n    \"Loss\": [tr[5], va[5], te[5]],\n    \"AUC\": [tr[4], va[4], te[4]],\n\n    \"Inference Time per Sample (ms)\": [\n        tr[8],\n        va[8],\n        te[8]\n    ],\n\n    \"Total Inference Time (sec)\": [\n        tr[9],\n        va[9],\n        te[9]\n    ],\n\n    \"Training Time (sec)\": [training_time]*3,\n    \"RAM Used (MB)\": [ram_used]*3\n})\n\nprint(\"\\n===== FINAL PERFORMANCE TABLE =====\")\nprint(results.round(4))\n\nprint(\"\\n===== INFERENCE TIME =====\")\n\nprint(f\"Train  - Total: {tr[9]:.4f} sec | Avg/sample: {tr[8]:.4f} ms\")\nprint(f\"Val    - Total: {va[9]:.4f} sec | Avg/sample: {va[8]:.4f} ms\")\nprint(f\"Test   - Total: {te[9]:.4f} sec | Avg/sample: {te[8]:.4f} ms\")\n\n\n# ============================================================\n# TERMINAL STYLE PREDICTION\n# ============================================================\ndef predict_disease_terminal(text):\n\n    model.eval()\n\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", str(text))\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n\n    encoding = tokenizer(\n        text,\n        padding=\"max_length\",\n        truncation=True,\n        max_length=MAX_LEN,\n        return_tensors=\"pt\"\n    )\n\n    with torch.no_grad():\n        outputs = model(\n            encoding[\"input_ids\"].to(device),\n            encoding[\"attention_mask\"].to(device)\n        )\n        probabilities = torch.softmax(outputs, dim=1).cpu().numpy()[0]\n\n    results_pred = pd.DataFrame({\n        \"Disease Name\": bangla_class_names,\n        \"Probability\": probabilities\n    }).sort_values(by=\"Probability\", ascending=False).reset_index(drop=True)\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"🩺 DISEASE PREDICTION RESULT\")\n    print(\"=\"*60)\n\n    print(\"\\n🔹 Input Symptoms:\")\n    print(text)\n\n    print(\"\\n🔹 Top Prediction:\")\n    print(f\"👉 {results_pred.iloc[0]['Disease Name']}\")\n    print(f\"🔥 Confidence: {results_pred.iloc[0]['Probability']*100:.2f}%\")\n\n    return results_pred\n\n# ============================================================\n# RUN SAMPLE PREDICTIONS (Test Set)\n# ============================================================\nsamples = [\n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে। আমার বুকে মাঝে মাঝে সারা রাত ব্যথা হয়, এবং আমি মাঝে মাঝে অসুস্থ বোধ করি।\",\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে। এমন কিছু অঞ্চলও রয়েছে যেগুলি আমার ত্বকের বাকি অংশের চেয়ে বেশি গাঢ় রঙের, এবং আমার কিছু বেদনাদায়ক পিণ্ড রয়েছে।\",\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না। আমার বুকে ব্যাথা হয় এবং আমার হৃদয় মনে হয় যেন আমি কাশির সময় ঘন্টায় এক মিলিয়ন মাইল বেগে দৌড়াচ্ছে। আমি একটি খারাপ মরিচা কফ আউট কাশি করছি.\",\n    \"আমি খুব বমি বমি ভাব অনুভব করি এবং বুকে ব্যথা অনুভব করি। সম্প্রতি আমি বুকে ব্যথা অনুভব করছি। আমি