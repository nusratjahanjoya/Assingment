EPLACEMENT\n# =========================\n\ndef replace_synonyms(text):\n\n    for key in synonyms:\n\n        if key in text:\n\n            text = text.replace(key, random.choice(synonyms[key]))\n\n    return text\n\n# =========================\n# NATURAL LANGUAGE VARIATION\n# =========================\n\ndef natural_variation(sentence):\n\n    starter = random.choice(natural_starters)\n    ending = random.choice(natural_endings)\n    emotion = random.choice(emotion_phrases)\n\n    sentence = f\"{starter} {emotion} {sentence} {ending}\"\n\n    sentence = re.sub(r\"\\s+\",\" \",sentence).strip()\n\n    return sentence \n    \n# =========================\n# SYMPTOM SHUFFLING\n# =========================\n\ndef shuffle_symptoms(text):\n\n    symptoms = re.split(r\",| এবং | ও \", text)\n\n    if len(symptoms) > 1:\n\n        random.shuffle(symptoms)\n\n    return \" এবং \".join(symptoms)\n\n\n# =========================\n# MULTI SYMPTOM GENERATION\n# =========================\n\ndef generate_multi_symptom(text):\n\n    symptoms = re.split(r\",| এবং | ও \", text)\n\n    k = random.randint(1, min(3,len(symptoms)))\n\n    chosen = random.sample(symptoms, k)\n\n    return \" এবং \".join(chosen)\n\n\n# =========================\n# GRAMMAR VARIATION\n# =========================\n\ngrammar_variants = [\n    \"লাগছে\",\n    \"হচ্ছে\",\n    \"অনুভব করছি\",\n    \"দেখা দিচ্ছে\",\n    \"মনে হচ্ছে\",\n    \"অনুভূত হচ্ছে\",\n    \"প্রকাশ পাচ্ছে\",\n    \"গুরুত্ব অনুভব করছি\",\n    \"দেখা যাচ্ছে\",\n    \"উদ্ভব হচ্ছে\",\n    \"ঘটছে\",\n    \"প্রকাশিত হচ্ছে\",\n    \"মধ্যমভাবে অনুভব করছি\",\n    \"অভিজ্ঞতা হচ্ছে\",\n    \"জাহির হচ্ছে\",\n    \"প্রকাশ পাচ্ছে\",\n    \"পাওয়া যাচ্ছে\",\n    \"উদ্ভাসিত হচ্ছে\",\n    \"জানি লাগছে\",\n    \"স্বীকার করছি\"\n]\n\ndef grammar_variation(sentence):\n\n    word = random.choice(grammar_variants)\n\n    sentence = re.sub(r\"(হচ্ছে|লাগছে|অনুভব করছি|দেখা দিচ্ছে)\",word,sentence)\n\n    return sentence\n\n\n# =========================\n# FULL AUGMENT FUNCTION\n# =========================\n\ndef augment_sentence(text):\n\n    text = replace_synonyms(text)\n\n    text = generate_multi_symptom(text)\n\n    text = shuffle_symptoms(text)\n\n    template = random.choice(templates)\n\n    sentence = template.replace(\"{symptoms}\",text)\n\n    sentence = grammar_variation(sentence)\n\n    sentence = natural_variation(sentence)\n\n    return sentence\n\n\n# =========================\n# GENERATE AUGMENTED DATA\n# =========================\n\naug_texts = []\naug_labels = []\n\nprint(\"Generating Augmented Samples Train datset:\")\n\nfor i, row in train_df.iterrows():\n\n    text = row[\"Symptom_Description\"]\n    label = row[\"Disease_Label\"]\n\n    for _ in range(AUGMENT_PER_SAMPLE):\n\n        new_text = augment_sentence(text)\n\n        aug_texts.append(new_text)\n        aug_labels.append(label)\n\naug_df = pd.DataFrame({\n\"Disease_Label\": aug_labels,\n\"Symptom_Description\": aug_texts\n})\n\naug_df.insert(0, \"ID\", range(len(train_df)+1, len(train_df)+len(aug_df)+1))\n\nprint(\"Generated Augmented Train datset:\",len(aug_df))\n\n\ntrain_augmented = pd.concat([train_df, aug_df], ignore_index=True)\n\ntrain_augmented[\"ID\"] = range(1, len(train_augmented)+1)\n\nprint(\"Before duplicate removal Train datset:\", len(train_augmented))\n\ntrain_augmented.drop_duplicates(subset=[\"Symptom_Description\"], inplace=True)\n\ntrain_augmented = train_augmented.reset_index(drop=True)\ntrain_augmented[\"ID\"] = range(1, len(train_augmented)+1)\n\nprint(\"After duplicate removal Train datset:\", len(train_augmented))\n\n\ntrain_augmented = train_augmented[[\"ID\",\"Disease_Label\",\"Symptom_Description\"]]\nval_df = val_df[[\"ID\",\"Disease_Label\",\"Symptom_Description\"]]\ntest_df = test_df[[\"ID\",\"Disease_Label\",\"Symptom_Description\"]]\n\n\n\n# =========================\n# SAVE FILES \n# =========================\n\ntrain_augmented.to_csv(\n    OUTPUT_TRAIN,\n    index=False,\n    encoding=\"utf-8-sig\"\n)\n\nval_df.to_csv(\n    OUTPUT_VAL,\n    index=False,\n    encoding=\"utf-8-sig\"\n)\n\ntest_df.to_csv(\n    OUTPUT_TEST,\n    index=False,\n    encoding=\"utf-8-sig\"\n)\n\nprint(\"Files Saved Successfully \")\n ","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-03-13T12:33:57.551786Z","iopub.execute_input":"2026-03-13T12:33:57.552499Z","iopub.status.idle":"2026-03-13T12:33:59.366815Z","shell.execute_reply.started":"2026-03-13T12:33:57.552469Z","shell.execute_reply":"2026-03-13T12:33:59.366212Z"}},"outputs":[{"name":"stdout","text":"Original Dataset: 1200\nTrain: 840\nValidation: 180\nTest: 180\nGenerating Augmented Samples Train datset:\nGenerated Augmented Train datset: 42000\nBefore duplicate removal Train datset: 42840\nAfter duplicate removal Train datset: 42817\nFiles Saved Successfully \n","output_type":"stream"}],"execution_count":3},{"cell_type":"code","source":"# ============================================================\n# INSTALL DEPENDENCIES\n# ============================================================\n!pip install -q transformers torch scikit-learn pandas numpy matplotlib seaborn psutil\n\n# ============================================================\n# IMPORTS\n# ============================================================\nimport pandas as pd\nimport numpy as np\nimport re\nimport torch\nimport torch.nn as nn\nimport warnings\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport time\nimport psutil\nimport os\nimport random\n\nfrom torch.utils.data import Dataset, DataLoader\nfrom transformers import AutoTokenizer, AutoModel\nfrom sklearn.preprocessing import LabelEncoder, label_binarize\nfrom sklearn.metrics import accuracy_score, precision_recall_fscore_support\nfrom sklearn.metrics import classification_report, roc_auc_score, confusion_matrix\n\nwarnings.filterwarnings(\"ignore\")\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# REPRODUCIBILITY\n# ============================================================\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\ntorch.cuda.manual_seed_all(SEED)\ntorch.backends.cudnn.deterministic = True\ntorch.backends.cudnn.benchmark = False\n\n# ============================================================\n# LOAD PRE-SPLIT DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/working/train_augmented_25.csv\")\nval_df   = pd.read_csv(\"/kaggle/working/validation-25.csv\")\ntest_df  = pd.read_csv(\"/kaggle/working/test-25.csv\")\n\nTEXT_COL = \"Symptom_Description\"\nLABEL_COL = \"Disease_Label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# LABEL ENCODING (FIT ONLY ON TRAIN)\n# ============================================================\nle = LabelEncoder()\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nbangla_class_names = le.classes_\n\n# ============================================================\n# TOKENIZER\n# ============================================================\nMODEL_NAME = \"csebuetnlp/banglabert\"\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\nMAX_LEN = 128\n\n# ============================================================\n# DATASET CLASS\n# ============================================================\nclass BanglaDataset(Dataset):\n    def __init__(self, texts, labels):\n        self.texts = texts.tolist()\n        self.labels = labels.tolist()\n\n    def __len__(self):\n        return len(self.texts)\n\n    def __getitem__(self, idx):\n        enc = tokenizer(\n            self.texts[idx],\n            padding=\"max_length\",\n            truncation=True,\n            max_length=MAX_LEN,\n            return_tensors=\"pt\"\n        )\n\n        return {\n            \"input_ids\": enc[\"input_ids\"].squeeze(0),\n            \"attention_mask\": enc[\"attention_mask\"].squeeze(0),\n            \"labels\": torch.tensor(self.labels[idx], dtype=torch.long)\n        }\n\n# Train loader (shuffle=True)\ntrain_loader = DataLoader(\n    BanglaDataset(train_df[TEXT_COL], train_df[\"label_id\"]),\n    batch_size=32, shuffle=True\n)\n\n\ntrain_eval_loader = DataLoader(\n    BanglaDataset(train_df[TEXT_COL], train_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\nval_loader = DataLoader(\n    BanglaDataset(val_df[TEXT_COL], val_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\ntest_loader = DataLoader(\n    BanglaDataset(test_df[TEXT_COL], test_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\n# ============================================================\n# MODEL\n# ============================================================\nclass BanglaBERT_Classifier(nn.Module):\n    def __init__(self, num_classes):\n        super().__init__()\n        self.bert = AutoModel.from_pretrained(MODEL_NAME)\n\n        for param in self.bert.parameters():\n            param.requires_grad = False\n\n        for name, param in self.bert.named_parameters():\n            if \"encoder.layer.10\" in name or \"encoder.layer.11\" in name:\n                param.requires_grad = True\n\n        self.dropout = nn.Dropout(0.4)\n        self.fc = nn.Linear(self.bert.config.hidden_size, num_classes)\n\n    def forward(self, input_ids, attention_mask