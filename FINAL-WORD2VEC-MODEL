_LEN - len(ids))\n    else:\n        ids = ids[:MAX_LEN]\n    return ids\n\nclass W2VDataset(Dataset):\n    def __init__(self, token_list, labels):\n        self.tokens = token_list.reset_index(drop=True)\n        self.labels = labels.reset_index(drop=True)\n\n    def __len__(self):\n        return len(self.tokens)\n\n    def __getitem__(self, idx):\n        ids = encode_text(self.tokens.iloc[idx])\n        return {\n            \"input_ids\": torch.tensor(ids, dtype=torch.long),\n            \"labels\": torch.tensor(self.labels.iloc[idx], dtype=torch.long)\n        }\n\n# DataLoaders\ntrain_loader = DataLoader(W2VDataset(train_tokens, train_df[\"label_id\"]), batch_size=32, shuffle=True)\n\ntrain_eval_loader = DataLoader(W2VDataset(train_tokens, train_df[\"label_id\"]), batch_size=32, shuffle=False)\n\nval_loader = DataLoader(W2VDataset(val_tokens, val_df[\"label_id\"]), batch_size=32, shuffle=False)\n\ntest_loader = DataLoader(W2VDataset(test_tokens, test_df[\"label_id\"]), batch_size=32, shuffle=False)\n\n# ============================================================\n# MODEL (Word2Vec + Bi-RNN)\n# ============================================================\nclass W2V_BiRNN(nn.Module):\n    def __init__(self):\n        super().__init__()\n\n        self.embedding = nn.Embedding.from_pretrained(\n            torch.tensor(embedding_matrix, dtype=torch.float32),\n            freeze=False\n        )\n\n        # 🔥 Replace LSTM with Simple RNN\n        self.rnn = nn.RNN(\n            input_size=EMBEDDING_DIM,\n            hidden_size=256,\n            num_layers=2,\n            batch_first=True,\n            bidirectional=True,\n            nonlinearity='relu'  # or 'relu'\n        )\n\n        self.dropout = nn.Dropout(0.4)\n        self.fc = nn.Linear(512, num_classes)\n\n    def forward(self, x):\n        x = self.embedding(x)\n\n        rnn_out, _ = self.rnn(x)\n\n        # Take last time step\n        x = torch.mean(rnn_out, dim=1)\n\n        x = self.dropout(x)