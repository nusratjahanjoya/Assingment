 Random Forest MODEL**","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# INSTALL DEPENDENCIES\n# ============================================================\n!pip install -q gensim scikit-learn pandas numpy matplotlib seaborn psutil joblib\n\n# ============================================================\n# IMPORTS\n# ============================================================\nimport pandas as pd\nimport numpy as np\nimport re\nimport warnings\nimport time\nimport psutil\nimport os\nimport random\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\nfrom gensim.models import Word2Vec\n\nfrom sklearn.preprocessing import LabelEncoder, label_binarize\nfrom sklearn.ensemble import RandomForestClassifier\nfrom sklearn.metrics import (\n    accuracy_score,\n    precision_recall_fscore_support,\n    classification_report,\n    roc_auc_score,\n    confusion_matrix,\n    log_loss\n)\n\nwarnings.filterwarnings(\"ignore\")\n\n# ============================================================\n# SYSTEM INFO\n# ============================================================\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# SEED\n# ============================================================\nSEED = 42\n\nrandom.seed(SEED)\nnp.random.seed(SEED)\n\n# ============================================================\n# LOAD DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/train_f15.csv\")\nval_df   = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/val_f15.csv\")\ntest_df  = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/test_f15.csv\")\n\nTEXT_COL = \"text\"\nLABEL_COL = \"label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n\n    text = str(text)\n\n    text = text.lower()\n\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n\n    text = re.sub(r\"[^\\u0980-\\u09FFa-zA-Z\\s]\", \" \", text)\n\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n\n    return text\n\nfor df in [train_df, val_df, test_df]:\n\n    df.dropna(inplace=True)\n\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n\n# ============================================================\n# LABEL ENCODING\n# ============================================================\nall_labels = pd.concat([\n    train_df[LABEL_COL],\n    val_df[LABEL_COL],\n    test_df[LABEL_COL]\n])\n\nle = LabelEncoder()\n\nle.fit(all_labels)\n\ntrain_df[\"label_id\"] = le.transform(train_df[LABEL_COL])\n\nval_df[\"label_id\"] = le.transform(val_df[LABEL_COL])\n\ntest_df[\"label_id\"] = le.transform(test_df[LABEL_COL])\n\nbangla_class_names = list(le.classes_)\n\nclass_names = np.unique(train_df[\"label_id\"])\n\nnum_classes = len(class_names)\n\n# ============================================================\n# TOKENIZATION\n# ============================================================\ntrain_tokens = [\n    text.split()\n    for text in train_df[TEXT_COL].values\n]\n\nval_tokens = [\n    text.split()\n    for text in val_df[TEXT_COL].values\n]\n\ntest_tokens = [\n    text.split()\n    for text in test_df[TEXT_COL].values\n]\n\n# ============================================================\n# TRAIN WORD2VEC\n# ============================================================\nprint(\"=\" * 60)\nprint(\"TRAINING WORD2VEC MODEL...\")\nprint(\"=\" * 60)\n\nstart_time = time.time()\n\nram_before = process.memory_info().rss / (1024 ** 2)\n\nw2v_model = Word2Vec(\n    sentences=train_tokens,\n    vector_size=300,\n    window=10,\n    min_count=1,\n    workers=4,\n    sg=1,\n    epochs=40,\n    negative=10,\n    sample=1e-5,\n    seed=SEED\n)\n\n# ============================================================\n# DOCUMENT VECTOR\n# ============================================================\ndef document_vector(tokens):\n\n    vectors = []\n\n    for word in tokens:\n\n        if word in w2v_model.wv:\n\n            vectors.append(w2v_model.wv[word])\n\n    if len(vectors) == 0:\n\n        return np.zeros(w2v_model.vector_size * 2)\n\n    vectors = np.array(vectors)\n\n    mean_vec = np.mean(vectors, axis=0)\n\n    max_vec = np.max(vectors, axis=0)\n\n    final_vec = np.concatenate([\n        mean_vec,\n        max_vec\n    ])\n\n    return final_vec\n\n# ============================================================\n# FEATURE EXTRACTION\n# ============================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"EXTRACTING WORD2VEC FEATURES...\")\nprint(\"=\" * 60)\n\nX_train_vec = np.array([\n    document_vector(tokens)\n    for tokens in train_tokens\n])\n\nX_val_vec = np.array([\n    document_vector(tokens)\n    for tokens in val_tokens\n])\n\nX_test_vec = np.array([\n    document_vector(tokens)\n    for tokens in test_tokens\n])\n\ny_train = train_df[\"label_id\"].values\n\ny_val = val_df[\"label_id\"].values\n\ny_test = test_df[\"label_id\"].values\n\n# ============================================================\n# RANDOM FOREST MODEL\n# ============================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"TRAINING RANDOM FOREST MODEL...\")\nprint(\"=\" * 60)\n\nclf = RandomForestClassifier(\n\n    n_estimators=1000,\n\n    max_depth=30,\n\n    min_samples_split=3,\n\n    min_samples_leaf=1,\n\n    max_features=\"sqrt\",\n\n    bootstrap=True,\n\n    class_weight=\"balanced_subsample\",\n\n    random_state=SEED,\n\n    n_jobs=-1\n)\n\nclf.fit(X_train_vec, y_train)\n\nend_time = time.time()\n\nram_after = process.memory_info().rss / (1024 ** 2)\n\ntraining_time = end_time - start_time\n\nram_used = ram_after - ram_before\n\n# ============================================================\n# MODEL WRAPPER\n# ============================================================\nclass Word2VecRFModel:\n\n    def __init__(self, word2vec_model, rf_model):\n\n        self.word2vec = word2vec_model\n\n        self.rf = rf_model\n\n    def predict(self, X):\n\n        return self.rf.predict(X)\n\n    def predict_proba(self, X):\n\n        return self.rf.predict_proba(X)\n\nmodel = Word2VecRFModel(\n    w2v_model,\n    clf\n)\n\n# ============================================================\n# SAFE AUC\n# ============================================================\ndef safe_auc_score(labels, probs):\n\n    try:\n\n        y_bin = label_binarize(\n            labels,\n            classes=list(range(num_classes))\n        )\n\n        auc = roc_auc_score(\n            y_bin,\n            probs,\n            average=\"weighted\",\n            multi_class=\"ovr\"\n        )\n\n        return auc\n\n    except:\n\n        return 0\n\n# ============================================================\n# EVALUATION\n# ============================================================\ndef evaluate(X_vec, labels):\n\n    start_inf = time.time()\n\n    preds = model.predict(X_vec)\n\n    probs = model.predict_proba(X_vec)\n\n    total_inference_time = time.time() - start_inf\n\n    avg_time_per_sample = (\n        total_inference_time / len(labels)\n    ) * 1000\n\n    acc = accuracy_score(labels, preds)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(\n        labels,\n        preds,\n        average=\"weighted\"\n    )\n\n    auc = safe_auc_score(labels, probs)\n\n    try:\n\n        loss = log_loss(labels, probs)\n\n    except:\n\n        loss = 0\n\n    return (\n        acc,\n        pr,\n        rc,\n        f1,\n        auc,\n        loss,\n        preds,\n        labels,\n        avg_time_per_sample,\n        total_inference_time\n    )\n\n# ============================================================\n# FINAL EVALUATION\n# ============================================================\ntr = evaluate(X_train_vec, y_train)\n\nva = evaluate(X_val_vec, y_val)\n\nte = evaluate(X_test_vec, y_test)\n\n# ============================================================\n# PERFORMANCE TABLE\n# ============================================================\nresults = pd.DataFrame({\n\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n\n    \"Accuracy\": [\n        tr[0],\n        va[0],\n        te[0]\n    ],\n\n    \"Precision\": [\n        tr[1],\n        va[1],\n        te[1]\n    ],\n\n    \"Recall\": [\n        tr[2],\n        va[2],\n        te[2]\n    ],\n\n    \"F1-score\": [\n        tr[3],\n        va[3],\n        te[3]\n    ],\n\n    \"Loss\": [\n        tr[5],\n        va[5],\n        te[5]\n    ],\n\n    \"AUC\": [\n        tr[4],\n        va[4],\n        te[4]\n    ],\n\n    \"Inference Time per Sample (ms)\": [\n        tr[8],\n        va[8],\n        te[8]\n    ],\n\n    \"Total Inference Time (sec)\": [\n        tr[9],\n        va[9],\n        te[9]\n    ],\n\n    \"Training Time (sec)\": [\n        training_time\n    ] * 3,\n\n    \"RAM Used (MB)\": [\n        ram_used\n    ] * 3\n})\n\nprint(\"\\n===== FINAL PERFORMANCE TABLE =====\")\n\nprint(results.round(4))\n\n# ============================================================\n# CLASSIFICATION REPORT\n# ============================================================\nprint(\"\\n===== CLASSIFICATION REPORT (TEST) =====\")\n\nprint(\n    classification_report(\n        te[7],\n        te[6],\n        target_names=bangla_class_names,\n        digits=4\n    )\n)\n\n# ============================================================\n# TERMINAL PREDICTION\n# ============================================================\ndef predict_disease_terminal(text):\n\n    text = clean_text(text)\n\n    tokens = text.split()\n\n    emb = document_vector(tokens).reshape(1, -1)\n\n    probabilities = model.rf.predict_proba(emb)[0]\n\n    results_pred = pd.DataFrame({\n\n        \"Disease Name\": bangla_class_names,\n\n        \"Probability\": probabilities\n\n    }).sort_values(\n        by=\"Probability\",\n        ascending=False\n    ).reset_index(drop=True)\n\n    print(\"\\n\" + \"=\" * 60)\n\n    print(\"DISEASE PREDICTION RESULT\")\n\n    print(\"=\" * 60)\n\n    print(\"\\nInput Symptoms:\")\n\n    print(text)\n\n    print(\"\\nTop Prediction:\")\n\n    print(results_pred.iloc[0][\"Disease Name\"])\n\n    print(\n        f\"Confidence: \"\n        f\"{results_pred.iloc[0]['Probability'] * 100:.2f}%\"\n    )\n\n    return results_pred\n\n# ============================================================\n# RUN SAMPLE PREDICTIONS\n# ============================================================\nsamples = [\n    \n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে। আমার বুকে মাঝে মাঝে সারা রাত ব্যথা হয়, এবং আমি মাঝে মাঝে অসুস্থ বোধ করি।\",\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে। এমন কিছু অঞ্চলও রয়েছে যেগুলি আমার ত্বকের বাকি অংশের চেয়ে বেশি গাঢ় রঙের, এবং আমার কিছু বেদনাদায়ক পিণ্ড রয়েছে।\",\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না। আমার বুকে ব্যাথা হয় এবং আমার হৃদয় মনে হয় যেন আমি কাশির সময় ঘন্টায় এক মিলিয়ন মাইল বেগে দৌড়াচ্ছে। আমি একটি খারাপ মরিচা কফ আউট কাশি করছি.\",\n    \"আমি খুব বমি বমি ভাব অনুভব করি এবং বুকে ব্যথা অনুভব করি। সম্প্রতি আমি বুকে ব্যথা অনুভব করছি। আমি খুব অস্বস্তি বোধ করি এবং প্রায়শই প্রচুর ঘাম হয়\",\n    \"আমি যখন ঘুম থেকে উঠি তখন আমি প্রায়শই একটি খোঁচা কণ্ঠস্বর বা ব্যথাযুক্ত গলা পাই। আমার নিঃশ্বাসে দুর্গন্ধ এবং ক্রমাগত গলা ব্যথা হচ্ছে। আমারও অনেক বমি হয়।\",\n    \"আমি ওজন হারাচ্ছি, সত্যিই ক্লান্ত বোধ করছি, এবং অনেক বেশি নিক্ষেপ করছি। আমার ত্বক হলুদ হয়ে গেছে, এবং আমার প্রচণ্ড জ্বর হয়েছে। আমার গাঢ় প্রস্রাব হয়েছে, এবং আমার পেটে ব্যথা হচ্ছে।\",\n    \"আমি যে পেশীর ব্যথা অনুভব করছি তা গুরুতর এবং একটি ধ্রুবক ব্যথার মতো অনুভব করে। আমার সারা শরীরে লাল দাগ আছে এবং চুলকানির কারণে আমার খুব অস্বস্তি হচ্ছে।\",\n    \"আমার ঘাড় অত্যন্ত শক্ত হয়েছে এবং আমার পেশী অত্যন্ত দুর্বল হয়েছে। আমার জয়েন্টে ফুলে যাওয়ার ফলে, শক্ত অনুভব না করে চলাফেরা করতে আমার অসুবিধা হয়। উপরন্তু, হাঁটা অত্যন্ত অস্বস্তিকর হয়েছে.\",\n    \"আজ সকালে, আমি বুঝতে পারি যে আমার সারা শরীরে একটি বড় ফুসকুড়ি হয়েছে। যত্রতত্র পুঁজ এবং ব্ল্যাকহেডস ভরা প্রচুর ব্রণ রয়েছে এবং আমার ত্বক অনেক বেশি ঘা হয়ে গেছে।\"\n    \n]\n\nfor s in samples:\n\n    predict_disease_terminal(s)\n\n# ============================================================\n# NORMALIZED CONFUSION MATRIX\n# ============================================================\ny_true = te[7]\n\ny_pred = te[6]\n\ncm = confusion_matrix(y_true, y_pred)\n\ncm_normalized = cm.astype(\"float\") / cm.sum(axis=1)[:, np.newaxis]\n\nplt.figure(figsize=(14, 12))\n\nsns.heatmap(\n    cm_normalized,\n    annot=True,\n    fmt=\".2f\",\n    cmap=\"viridis\"\n)\n\nplt.title(\n    \"Normalized Confusion Matrix\\nWord2Vec + Random Forest MODEL\",\n    fontsize=16\n)\n\nplt.xlabel(\"Predicted Label\")\n\nplt.ylabel(\"True Label\")\n\nplt.xticks(rotation=90)\n\nplt.yticks(rotation=0)\n\nplt.tight_layout()\n\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-05-09T04:43:45.047163Z","iopub.execute_input":"2026-05-09T04:43:45.047667Z","iopub.status.idle":"2026-05-09T04:44:42.027574Z","shell.execute_reply.started":"2026-05-09T04:43:45.047632Z","shell.execute_reply":"2026-05-09T04:44:42.026698Z"}},"outputs":[{"name":"stdout","text":"============================================================\nTRAINING WORD2VEC MODEL...\n============================================================\n\n============================================================\nEXTRACTING WORD2VEC FEATURES...\n============================================================\n\n============================================================\nTRAINING RANDOM FOREST MODEL...\n============================================================\n\n===== FINAL PERFORMANC