mptoms:\nআমার ঘাড় অত্যন্ত শক্ত হয়েছে এবং আমার পেশী অত্যন্ত দুর্বল হয়েছে। আমার জয়েন্টে ফুলে যাওয়ার ফলে, শক্ত অনুভব না করে চলাফেরা করতে আমার অসুবিধা হয়। উপরন্তু, হাঁটা অত্যন্ত অস্বস্তিকর হয়েছে.\n\n🔹 Top Prediction:\nআর্থ্রাইটিস\nConfidence: 96.58%\n\n============================================================\n🩺 DISEASE PREDICTION RESULT\n============================================================\n\n🔹 Input Symptoms:\nআজ সকালে, আমি বুঝতে পারি যে আমার সারা শরীরে একটি বড় ফুসকুড়ি হয়েছে। যত্রতত্র পুঁজ এবং ব্ল্যাকহেডস ভরা প্রচুর ব্রণ রয়েছে এবং আমার ত্বক অনেক বেশি ঘা হয়ে গেছে।\n\n🔹 Top Prediction:\nব্রণ\nConfidence: 78.63%\n","output_type":"stream"},{"output_type":"display_data","data":{"text/plain":"<Figure size 1400x1200 with 2 Axes>","image/png":"\n"},"metadata":{}}],"execution_count":7},{"cell_type":"markdown","source":"**5. WORD2VEC + GRU MODEL** ","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# INSTALL DEPENDENCIES\n# ============================================================\n!pip install -q gensim torch scikit-learn pandas numpy matplotlib seaborn psutil\n\n# ============================================================\n# IMPORTS\n# ============================================================\nimport pandas as pd\nimport numpy as np\nimport re\nimport torch\nimport torch.nn as nn\nimport warnings\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport time\nimport psutil\nimport os\nimport random\n\nfrom torch.utils.data import Dataset, DataLoader\nfrom gensim.models import Word2Vec\nfrom sklearn.preprocessing import LabelEncoder, label_binarize\nfrom sklearn.metrics import accuracy_score, precision_recall_fscore_support\nfrom sklearn.metrics import roc_auc_score, confusion_matrix\n\nwarnings.filterwarnings(\"ignore\")\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# REPRODUCIBILITY\n# ============================================================\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\n\n# ============================================================\n# LOAD DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/train_f15.csv\")\nval_df   = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/val_f15.csv\")\ntest_df  = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/test_f15.csv\")\n\nTEXT_COL = \"text\"\nLABEL_COL = \"label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# TOKENIZATION\n# ============================================================\ndef tokenize(text):\n    return text.split()\n\ntrain_tokens = train_df[TEXT_COL].apply(tokenize)\nval_tokens   = val_df[TEXT_COL].apply(tokenize)\ntest_tokens  = test_df[TEXT_COL].apply(tokenize)\n\n# ============================================================\n# WORD2VEC TRAINING\n# ============================================================\nw2v_model = Word2Vec(\n    sentences=train_tokens,\n    vector_size=200,\n    window=5,\n    min_count=1,\n    workers=4\n)\n\nEMBEDDING_DIM = 200\n\n# ============================================================\n# BUILD VOCAB + EMBEDDING MATRIX\n# ============================================================\nword_index = {word: i+1 for i, word in enumerate(w2v_model.wv.index_to_key)}\nvocab_size = len(word_index) + 1\n\nembedding_matrix = np.zeros((vocab_size, EMBEDDING_DIM))\nfor word, i in word_index.items():\n    embedding_matrix[i] = w2v_model.wv[word]\n\n# ============================================================\n# LABEL ENCODING\n# ============================================================\nle = LabelEncoder()\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nbangla_class_names = le.classes_\n\n# ============================================================\n# DATASET\n# ============================================================\nMAX_LEN = 50\n\ndef encode_text(tokens):\n    ids = [word_index.get(w, 0) for w in tokens]\n    if len(ids) < MAX_LEN:\n        ids += [0] * (MAX_LEN - len(ids))\n    else:\n        ids = ids[:MAX_LEN]\n    return ids\n\nclass W2VDataset(Dataset):\n    def __init__(self, token_list, labels):\n        self.tokens = token_list.reset_index(drop=True)\n        self.labels = labels.reset_index(drop=True)\n\n    def __len__(self):\n        return len(self.tokens)\n\n    def __getitem__(self, idx):\n        ids = encode_text(self.tokens.iloc[idx])\n        return {\n            \"input_ids\": torch.tensor(ids, dtype=torch.long),\n            \"labels\": torch.tensor(self.labels.iloc[idx], dtype=torch.long)\n        }\n\n# DataLoaders\ntrain_loader = DataLoader(W2VDataset(train_tokens, train_df[\"label_id\"]), batch_size=32, shuffle=True)\n\ntrain_eval_loader = DataLoader(W2VDataset(train_tokens, train_df[\"label_id\"]), batch_size=32, shuffle=False)\n\nval_loader = DataLoader(W2VDataset(val_tokens, val_df[\"label_id\"]), batch_size=32, shuffle=False)\n\ntest_loader = DataLoader(W2VDataset(test_tokens, test_df[\"label_id\"]), batch_size=32, shuffle=False)\n\n# ============================================================\n# MODEL (Word2Vec + GRU)\n# ============================================================\nclass W2V_GRU(nn.Module):\n    def __init__(self):\n        super().__init__()\n\n        # Word2Vec Embedding\n        self.embedding = nn.Embedding.from_pretrained(\n            torch.tensor(embedding_matrix, dtype=torch.float32),\n            freeze=False\n        )\n\n        # GRU layer\n        self.gru = nn.GRU(\n            input_size=EMBEDDING_DIM,\n            hidden_size=256,\n            num_layers=2,\n            batch_first=True,\n            bidirectional=True\n        )\n\n        self.dropout = nn.Dropout(0.4)\n\n        # bidirectional → 256 * 2 = 512\n        self.fc = nn.Linear(512, num_classes)\n\n    def forward(self, x):\n        x = self.embedding(x)\n\n        gru_out, _ = self.gru(x)\n\n        # Better representation than last step\n        x = torch.mean(gru_out, dim=1)\n\n        x = self.dropout(x)\n        return self.fc(x)\n\n\n# Initialize model\nmodel = W2V_GRU().to(device)\n\n# ============================================================\n# LOSS + OPTIMIZER\n# ============================================================\ncriterion = nn.CrossEntropyLoss(label_smoothing=0.1)\noptimizer = torch.optim.Adam(model.parameters(), lr=1e-3)\n\n# ============================================================\n# EVALUATION\n# ============================================================\ndef evaluate(loader):\n    model.eval()\n    preds, labels, probs = [], [], []\n    total_loss = 0\n\n    start = time.time()\n\n    with torch.no_grad():\n        for batch in loader:\n\n            input_ids = batch[\"input_ids\"].to(device)\n            y = batch[\"labels\"].to(device)\n\n            logits = model(input_ids)\n            loss = criterion(logits, y)\n            total_loss += loss.item()\n\n            prob = torch.softmax(logits, dim=1)\n\n            probs.extend(prob.cpu().numpy())\n            preds.extend(torch.argmax(logits, dim=1).cpu().numpy())\n            labels.extend(y.cpu().numpy())\n\n    total_time = time.time() - start\n    avg_time = (total_time / len(labels)) * 1000\n\n    acc = accuracy_score(labels, preds)\n    pr, rc, f1, _ = precision_recall_fscore_support(labels, preds, average=\"weighted\")\n\n    y_bin = label_binarize(labels, classes=list(range(num_classes)))\n    auc = roc_auc_score(y_bin, np.array(probs), average=\"weighted\", multi_class=\"ovr\")\n\n    return acc, pr, rc, f1, auc, total_loss/len(loader), preds, labels, avg_time, total_time\n\n# ============================================================\n# TRAINING\n# ============================================================\nEPOCHS = 20\nbest_val_loss = float(\"inf\")\nbest_state = None\n\nstart_time = time.time()\n\nPATIENCE = 3\ncounter = 0\n\nfor epoch in range(EPOCHS):\n    model.train()\n    total_loss = 0\n\n    for batch in train_loader:\n        optimizer.zero_grad()\n\n        input_ids = batch[\"input_ids\"].to(device)\n        labels = batch[\"labels\"].to(device)\n\n        logits = model(input_ids)\n        loss = criterion(logits, labels)\n\n        loss.backward()\n        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n        optimizer.step()\n\n        total_loss += loss.item()\n\n    train_loss = total_loss / len(train_loader)\n\n    val_acc, val_pr, val_rc, val_f1, val_auc, val_loss, _, _, _, _ = evaluate(val_loader)\n\n    print(f\"Epoch {epoch+1}/{EPOCHS} | Train Loss: {train_loss:.4f} | Val Loss: {val_loss:.4f} | Val Acc: {val_acc:.4f} | Val F1: {val_f1:.4f}\")\n\n    if val_loss < best_val_loss:\n        best_val_loss = val_loss\n        best_state = model.state_dict()\n        counter = 0\n    else:\n        counter += 1\n        print(f\"EarlyStopping Counter: {counter}/{PATIENCE}\")\n        if counter >= PATIENCE:\n            print(\"⛔ Early stopping triggered\")\n            break\n\n# Load best model\nmodel.load_state_dict(best_state)\n\n# ============================================================\n# FINAL EVALUATION\n# ============================================================\ntr = evaluate(train_eval_loader)\nva = evaluate(val_loader)\nte = evaluate(test_loader)\n\n\n# ✅ ADD THIS PART HERE\ntraining_time = time.time() - start_time\nram_used = process.memory_info().rss / (1024 * 1024)\n\n# ============================================================\n# PERFORMANCE TABLE (WITH INFERENCE TIME)\n# ============================================================\nresults = pd.DataFrame({\n\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n\n    \"Accuracy\": [tr[0], va[0], te[0]],\n    \"Precision\": [tr[1], va[1], te[1]],\n    \"Recall\": [tr[2], va[2], te[2]],\n    \"F1-score\": [tr[3], va[3], te[3]],\n    \"Loss\": [tr[5], va[5], te[5]],\n    \"AUC\": [tr[4], va[4], te[4]],\n\n    \"Inference Time per Sample (ms)\": [\n        tr[8],\n        va[8],\n        te[8]\n    ],\n\n    \"Total Inference Time (sec)\": [\n        tr[9],\n        va[9],\n        te[9]\n    ],\n\n    \"Training Time (sec)\": [training_time]*3,\n    \"RAM Used (MB)\": [ram_used]*3\n})\n\n# ============================================================\n# PRINT RESULTS\n# ============================================================\nprint(\"\\n===== INFERENCE TIME =====\")\nprint(f\"Train  - Total: {tr[9]:.4f} sec | Avg/sample: {tr[8]:.4f} ms\")\nprint(f\"Val    - Total: {va[9]:.4f} sec | Avg/sample: {va[8]:.4f} ms\")\nprint(f\"Test   - Total: {te[9]:.4f} sec | Avg/sample: {te[8]:.4f} ms\")\n\nprint(\"\\n===== FINAL PERFORMANCE TABLE =====\")\nprint(results.round(4))\n\n# ============================================================\n# PREDICTION FUNCTION\n# ============================================================\ndef predict_disease_terminal(text):\n\n    model.eval()\n\n    text = clean_text(text)\n    tokens = tokenize(text)\n    ids = encode_text(tokens)\n\n    with torch.no_grad():\n        logits = model(torch.tensor([ids]).to(device))\n        probs = torch.softmax(logits, dim=1).cpu().numpy()[0]\n\n    df = pd.DataFrame({\n        \"Disease Name\": bangla_class_names,\n        \"Probability\": probs\n    }).sort_values(by=\"Probability\", ascending=False)\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"🩺 DISEASE PREDICTION RESULT\")\n    print(\"=\"*60)\n\n    print(\"\\n🔹 Input Symptoms:\")\n    print(text)\n\n    print(\"\\n🔹 Top Prediction:\")\n    print(f\"{df.iloc[0]['Disease Name']}\")\n    print(f\"Confidence: {df.iloc[0]['Probability']*100:.2f}%\")\n\n    return df\n\n# ============================================================\n# RUN SAMPLE PREDICTIONS (Test Set)\n# ============================================================\nsamples = [\n    \n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে। আমার বুকে মাঝে মাঝে সারা রাত ব্যথা হয়, এবং আমি মাঝে মাঝে অসুস্থ বোধ করি।\",\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে। এমন কিছু অঞ্চলও রয়েছে যেগুলি আমার ত্বকের বাকি অংশের চেয়ে বেশি গাঢ় রঙের, এবং আমার কিছু বেদনাদায়ক পিণ্ড রয়েছে।\",\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না। আমার বুকে ব্যাথা হয় এবং আমার হৃদয় মনে হয় যেন আমি কাশির সময় ঘন্টায় এক মিলিয়ন মাইল বেগে দৌড়াচ্ছে। আমি একটি খারাপ মরিচা কফ আউট কাশি করছি.\",\n    \"আমি খুব বমি বমি ভাব অনুভব করি এবং বুকে ব্যথা অনুভব করি। সম্প্রতি আমি বুকে ব্যথা অনুভব করছি। আমি খুব অস্বস্তি বোধ করি এবং প্রায়শই প্রচুর ঘাম হয়\",\n    \"আমি যখন ঘুম থেকে উঠি তখন আমি প্রায়শই একটি খোঁচা কণ্ঠস্বর বা ব্যথাযুক্ত গলা পাই। আমার নিঃশ্বাসে দুর্গন্ধ এবং ক্রমাগত গলা ব্যথা হচ্ছে। আমারও অনেক বমি হয়।\",\n    \"আমি ওজন হারাচ্ছি, সত্যিই ক্লান্ত বোধ করছি, এবং অনেক বেশি নিক্ষেপ করছি। আমার ত্বক হলুদ হয়ে গেছে, এবং আমার প্রচণ্ড জ্বর হয়েছে। আমার গাঢ় প্রস্রাব হয়েছে, এবং আমার পেটে ব্যথা হচ্ছে।\",\n    \"আমি যে পেশীর ব্যথা অনুভব করছি তা গুরুতর এবং একটি ধ্রুবক ব্যথার মতো অনুভব করে। আমার সারা শরীরে লাল দাগ আছ