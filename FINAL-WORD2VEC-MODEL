OL]])\nle.fit(all_labels)\n\ntrain_df[\"label_id\"] = le.transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nclass_names = np.unique(train_df[\"label_id\"])\nlabel_names = list(le.classes_)\n\n# ============================================================\n# TOKENIZATION FOR WORD2VEC\n# ============================================================\ndef tokenize(text):\n    return text.lower().split()\n\ntrain_sentences = train_df[TEXT_COL].apply(tokenize).tolist()\nval_sentences   = val_df[TEXT_COL].apply(tokenize).tolist()\ntest_sentences  = test_df[TEXT_COL].apply(tokenize).tolist()\n\n# ============================================================\n# WORD2VEC TRAINING\n# ============================================================\nw2v = Word2Vec(\n    sentences=train_sentences,\n    vector_size=200,\n    window=5,\n    min_count=1,\n    workers=4,\n    sg=1,\n    seed=SEED\n)\n\n# ============================================================\n# SENTENCE VECTOR (MEAN WORD EMBEDDING)\n# ============================================================\ndef sentence_vector(sentence):\n    vectors = []\n    for word in sentence:\n        if word in w2v.wv:\n            vectors.append(w2v.wv[word])\n    if len(vectors) == 0:\n        return np.zeros(200)\n    return np.mean(vectors, axis=0)\n\ndef build_features(sentences):\n    return np.array([sentence_vector(s) for s in sentences])\n\n# ============================================================\n# FEATURES\n# ============================================================\nX_train = build_features(train_sentences)\nX_val   = build_features(val_sentences)\nX_test  = build_features(test_sentences)\n\ny_train = train_df[\"label_id\"].values\ny_val   = val_df[\"label_id\"].values\ny_test  = test_df[\"label_id\"].values\n\n# ============================================================\n# XGBOOST MODEL\n# ============================================================\nnum_classes = len(class_names)\n\nmodel = XGBClassifier(\n    n_estimators=1500,\n    learning_rate=0.05,\n    max_depth=6,\n    subsample=0.8,\n    colsample_bytree=0.8,\n    objective=\"multi:softprob\",\n    num_class=num_classes,\n    eval_metric=\"mlogloss\",\n    tree_method=\"hist\",\n    random_state=SEED\n)\n\n# ============================================================\n# TRAIN\n# ============================================================\nstart_time = time.time()\nram_before = process.memory_info().rss / (1024**2)\n\nmodel.fit(X_train, y_train)\n\nend_time = time.time()\nram_after = process.memory_info().rss / (1024**2)\n\ntraining_time = end_time - start_time\nram_used = ram_after - ram_before\n\n# ============================================================\n# SAFE AUC\n# ============================================================\ndef safe_auc(y_true, y_prob):\n    try:\n        y_bin = label_binarize(y_true, classes=class_names)\n        return roc_auc_score(y_bin, y_prob, multi_class=\"ovr\", average=\"weighted\")\n    except:\n        return 0\n\n# ============================================================\n# EVALUATION FUNCTION\n# ============================================================\ndef evaluate(X, y):\n    start = time.time()\n\n    prob = model.predict_proba(X)\n    pred = np.argmax(prob, axis=1)\n\n    end = time.time()\n\n    acc = accuracy_score(y, pred)\n    pr, rc, f1, _ = precision_recall_fscore_support(y, pred, average=\"weighted\")\n    auc = safe_auc(y, prob)\n    loss = log_loss(y, prob)\n\n    return acc, pr, rc, f1, auc, loss, pred, y, (end-start)\n\n# ============================================================\n# RESULTS\n# ============================================================\ntr = evaluate(X_train, y_train)\nva = evaluate(X_val, y_val)\nte = evaluate(X_test, y_test)\n\nresults = pd.DataFrame({\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n    \"Accuracy\": [tr[0], va[0], te[0]],\n    \"Precision\": [tr[1], va[1], te[1]],\n    \"Recall\": [tr[2], va[2], te[2]],\n    \"F1-score\": [tr[3], va[3], te[3]],\n    \"AUC\": [tr[4], va[4], te[4]],\n    \"Loss\": [tr[5], va[5], te[5]],\n    \"Training Time (sec)\": [training_time]*3,\n    \"RAM Used (MB)\": [ram_used]*3\n})\n\nprint(\"\\n===== FINAL PERFORMANCE TABLE =====\")\nprint(results.round(4))\n\n# ============================================================\n# CLASSIFICATION REPORT\n# ============================================================\nprint(\"\\n===== CLASSIFICATION REPORT (TEST) =====\")\nprint(classification_report(te[7], te[6], target_names=label_names, digits=4))\n\n# ============================================================\n# PREDICTION FUNCTION\n# ============================================================\ndef predict(text):\n    text = clean_text(text)\n    vec = build_features([tokenize(text)])\n    prob = model.predict_proba(vec)[0]\n\n    df = pd.DataFrame({\n        \"Disease\": label_names,\n        \"Probability\": prob\n    }).sort_values(by=\"Probability\", ascending=False)\n\n    print(\"\\n===== PREDICTION =====\")\n    print(\"Input:\", text)\n    print(\"Top:\", df.iloc[0][\"Disease\"])\n    print(\"Confidence:\", round(df.iloc[0][\"Probability\"]*100, 2), \"%\")\n\n    return df\n\n# ============================================================\n# SAMPLE TEST\n# ============================================================\nsamples = [\n    \n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে। আমার বুকে মাঝে মাঝে সারা রাত ব্যথা হয়, এবং আমি মাঝে মাঝে অসুস্থ বোধ করি।\",\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে। এমন কিছু অঞ্চলও রয়েছে যেগুলি আমার ত্বকের বাকি অংশের চেয়ে বেশি গাঢ় রঙের, এবং আমার কিছু বেদনাদায়ক পিণ্ড রয়েছে।\",\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না। আমার বুকে ব্যাথা হয় এবং আমার হৃদয় মনে হয় যেন আমি কাশ