 + LOGISTIC REGRESSION MODEL**","metadata":{}},{"cell_type":"code","source":"# ============================================================\n# INSTALL DEPENDENCIES\n# ============================================================\n!pip install -q gensim scikit-learn pandas numpy matplotlib seaborn psutil joblib\n\n# ============================================================\n# IMPORTS\n# ============================================================\nimport pandas as pd\nimport numpy as np\nimport re\nimport warnings\nimport time\nimport psutil\nimport os\nimport random\nimport matplotlib.pyplot as plt\nimport seaborn as sns\n\nfrom gensim.models import Word2Vec\n\nfrom sklearn.preprocessing import (\n    LabelEncoder,\n    StandardScaler,\n    label_binarize\n)\n\nfrom sklearn.linear_model import LogisticRegression\n\nfrom sklearn.metrics import (\n    accuracy_score,\n    precision_recall_fscore_support,\n    classification_report,\n    roc_auc_score,\n    confusion_matrix,\n    log_loss\n)\n\nwarnings.filterwarnings(\"ignore\")\n\n# ============================================================\n# PROCESS INFO\n# ============================================================\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# SEED\n# ============================================================\nSEED = 42\n\nrandom.seed(SEED)\nnp.random.seed(SEED)\n\n# ============================================================\n# LOAD DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/train_f15.csv\")\nval_df   = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/val_f15.csv\")\ntest_df  = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f15/test_f15.csv\")\n\nTEXT_COL = \"text\"\nLABEL_COL = \"label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n\n    text = str(text)\n\n    text = text.lower()\n\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n\n    text = re.sub(r\"[^\\u0980-\\u09FFa-zA-Z\\s]\", \" \", text)\n\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n\n    return text\n\nfor df in [train_df, val_df, test_df]:\n\n    df.dropna(inplace=True)\n\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n\n# ============================================================\n# LABEL ENCODING\n# ============================================================\nall_labels = pd.concat([\n    train_df[LABEL_COL],\n    val_df[LABEL_COL],\n    test_df[LABEL_COL]\n])\n\nle = LabelEncoder()\n\nle.fit(all_labels)\n\ntrain_df[\"label_id\"] = le.transform(train_df[LABEL_COL])\n\nval_df[\"label_id\"] = le.transform(val_df[LABEL_COL])\n\ntest_df[\"label_id\"] = le.transform(test_df[LABEL_COL])\n\nbangla_class_names = list(le.classes_)\n\nclass_names = np.unique(train_df[\"label_id\"])\n\nnum_classes = len(class_names)\n\n# ============================================================\n# TOKENIZATION\n# ============================================================\ntrain_sentences = [\n    text.split()\n    for text in train_df[TEXT_COL]\n]\n\nval_sentences = [\n    text.split()\n    for text in val_df[TEXT_COL]\n]\n\ntest_sentences = [\n    text.split()\n    for text in test_df[TEXT_COL]\n]\n\n# ============================================================\n# TRAIN WORD2VEC\n# ============================================================\nprint(\"=\" * 60)\nprint(\"TRAINING WORD2VEC MODEL...\")\nprint(\"=\" * 60)\n\nstart_time = time.time()\n\nram_before = process.memory_info().rss / (1024 ** 2)\n\nw2v_model = Word2Vec(\n\n    sentences=train_sentences,\n\n    vector_size=300,\n\n    window=7,\n\n    min_count=1,\n\n    workers=4,\n\n    sg=1,\n\n    epochs=30,\n\n    seed=SEED\n)\n\n# ============================================================\n# SENTENCE EMBEDDING\n# ============================================================\ndef sentence_vector(tokens, model):\n\n    vectors = []\n\n    for word in tokens:\n\n        if word in model.wv:\n\n            vectors.append(model.wv[word])\n\n    if len(vectors) == 0:\n\n        return np.zeros(model.vector_size)\n\n    return np.mean(vectors, axis=0)\n\n# ============================================================\n# FEATURE EXTRACTION\n# ============================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"EXTRACTING WORD2VEC FEATURES...\")\nprint(\"=\" * 60)\n\nX_train_vec = np.array([\n    sentence_vector(tokens, w2v_model)\n    for tokens in train_sentences\n])\n\nX_val_vec = np.array([\n    sentence_vector(tokens, w2v_model)\n    for tokens in val_sentences\n])\n\nX_test_vec = np.array([\n    sentence_vector(tokens, w2v_model)\n    for tokens in test_sentences\n])\n\ny_train = train_df[\"label_id\"].values\n\ny_val = val_df[\"label_id\"].values\n\ny_test = test_df[\"label_id\"].values\n\n# ============================================================\n# FEATURE SCALING\n# ============================================================\nscaler = StandardScaler()\n\nX_train_vec = scaler.fit_transform(X_train_vec)\n\nX_val_vec = scaler.transform(X_val_vec)\n\nX_test_vec = scaler.transform(X_test_vec)\n\n# ============================================================\n# LOGISTIC REGRESSION MODEL\n# ============================================================\nprint(\"\\n\" + \"=\" * 60)\nprint(\"TRAINING LOGISTIC REGRESSION MODEL...\")\nprint(\"=\" * 60)\n\nclf = LogisticRegression(\n\n    C=2.5,\n\n    penalty=\"l2\",\n\n    solver=\"lbfgs\",\n\n    multi_class=\"multinomial\",\n\n    max_iter=5000,\n\n    class_weight=\"balanced\",\n\n    random_state=SEED,\n\n    n_jobs=-1\n)\n\nclf.fit(X_train_vec, y_train)\n\nend_time = time.time()\n\nram_after = process.memory_info().rss / (1024 ** 2)\n\ntraining_time = end_time - start_time\n\nram_used = ram_after - ram_before\n\n# ============================================================\n# MODEL WRAPPER\n# ============================================================\nclass Word2VecLogisticModel:\n\n    def __init__(self, w2v_model, lr_model):\n\n        self.w2v = w2v_model\n\n        self.lr = lr_model\n\n    def predict(self, X):\n\n        return self.lr.predict(X)\n\n    def predict_proba(self, X):\n\n        return self.lr.predict_proba(X)\n\nmodel = Word2VecLogisticModel(w2v_model, clf)\n\n# ============================================================\n# SAFE AUC\n# ============================================================\ndef safe_auc_score(labels, probs):\n\n    try:\n\n        y_bin = label_binarize(\n            labels,\n            classes=list(range(num_classes))\n        )\n\n        auc = roc_auc_score(\n            y_bin,\n            probs,\n            average=\"weighted\",\n            multi_class=\"ovr\"\n        )\n\n        return auc\n\n    except:\n\n        return 0\n\n# ============================================================\n# EVALUATION FUNCTION\n# ============================================================\ndef evaluate(X_vec, labels):\n\n    start_inf = time.time()\n\n    preds = model.predict(X_vec)\n\n    probs = model.predict_proba(X_vec)\n\n    total_inference_time = time.time() - start_inf\n\n    avg_time_per_sample = (\n        total_inference_time / len(labels)\n    ) * 1000\n\n    acc = accuracy_score(labels, preds)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(\n        labels,\n        preds,\n        average=\"weighted\"\n    )\n\n    auc = safe_auc_score(labels, probs)\n\n    try:\n\n        loss = log_loss(labels, probs)\n\n    except:\n\n        loss = 0\n\n    return (\n        acc,\n        pr,\n        rc,\n        f1,\n        auc,\n        loss,\n        preds,\n        labels,\n        avg_time_per_sa