 ============================================================\n!pip install -q transformers torch scikit-learn pandas numpy matplotlib seaborn psutil\n\n# ============================================================\n# IMPORTS\n# ============================================================\nimport pandas as pd\nimport numpy as np\nimport re\nimport torch\nimport torch.nn as nn\nimport warnings\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport time\nimport psutil\nimport os\nimport random\n\nfrom torch.utils.data import Dataset, DataLoader\nfrom transformers import AutoTokenizer, AutoModel\nfrom sklearn.preprocessing import LabelEncoder, label_binarize\nfrom sklearn.metrics import accuracy_score, precision_recall_fscore_support\nfrom sklearn.metrics import classification_report, roc_auc_score, confusion_matrix\n\nwarnings.filterwarnings(\"ignore\")\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# REPRODUCIBILITY\n# ============================================================\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\ntorch.cuda.manual_seed_all(SEED)\ntorch.backends.cudnn.deterministic = True\ntorch.backends.cudnn.benchmark = False\n\n# ============================================================\n# LOAD PRE-SPLIT DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f-15/train_f15.csv\")\nval_df   = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f-15/val_f15.csv\")\ntest_df  = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f-15/test_f15.csv\")\n\nTEXT_COL = \"text\"\nLABEL_COL = \"label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# LABEL ENCODING (FIT ONLY ON TRAIN)\n# ============================================================\nle = LabelEncoder()\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nbangla_class_names = le.classes_\n\n# ============================================================\n# TOKENIZER\n# ============================================================\nMODEL_NAME = \"csebuetnlp/banglabert\"\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\nMAX_LEN = 128\n\n# ============================================================\n# DATASET CLASS\n# ============================================================\nclass BanglaDataset(Dataset):\n    def __init__(self, texts, labels):\n        self.texts = texts.tolist()\n        self.labels = labels.tolist()\n\n    def __len__(self):\n        return len(self.texts)\n\n    def __getitem__(self, idx):\n        enc = tokenizer(\n            self.texts[idx],\n            padding=\"max_length\",\n            truncation=True,\n            max_length=MAX_LEN,\n            return_tensors=\"pt\"\n        )\n\n        return {\n            \"input_ids\": enc[\"input_ids\"].squeeze(0),\n            \"attention_mask\": enc[\"attention_mask\"].squeeze(0),\n            \"labels\": torch.tensor(self.labels[idx], dtype=torch.long)\n        }\n\n# Train loader (shuffle=True)\ntrain_loader = DataLoader(\n    BanglaDataset(train_df[TEXT_COL], train_df[\"label_id\"]),\n    batch_size=32, shuffle=True\n)\n\n\ntrain_eval_loader = DataLoader(\n    BanglaDataset(train_df[TEXT_COL], train_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\nval_loader = DataLoader(\n    BanglaDataset(val_df[TEXT_COL], val_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\ntest_loader = DataLoader(\n    BanglaDataset(test_df[TEXT_COL], test_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\n# ============================================================\n# MODEL (BanglaBERT + GRU)\n# ============================================================\nclass BanglaBERT_GRU(nn.Module):\n    def __init__(self, num_classes):\n        super().__init__()\n\n        self.bert = AutoModel.from_pretrained(MODEL_NAME)\n\n        # Freeze most BERT layers\n        for param in self.bert.parameters():\n            param.requires_grad = False\n\n        # Unfreeze last 2 layers\n        for name, param in self.bert.named_parameters():\n            if \"encoder.layer.10\" in name or \"encoder.layer.11\" in name:\n                param.requires_grad = True\n\n        hidden_size = self.bert.config.hidden_size\n\n        # 🔹 GRU Layer (Bidirectional)\n        self.gru = nn.GRU(\n            input_size=hidden_size,\n            hidden_size=256,\n            num_layers=1,\n            batch_first=True,\n            bidirectional=True\n        )\n\n        # 🔹 Dropout\n        self.dropout = nn.Dropout(0.4)\n\n        # 🔹 Fully Connected Layer\n        self.fc = nn.Linear(256 * 2, num_classes)  # bidirectional\n\n    def forward(self, input_ids, attention_mask):\n\n        outputs = self.bert(\n            input_ids=input_ids,\n            attention_mask=attention_mask\n        )\n\n        sequence_output = outputs.last_hidden_state  # (batch, seq_len, hidden)\n\n        # 🔹 Pass through Bi-GRU\n        gru_out, hidden = self.gru(sequence_output)\n\n        # hidden shape: (num_layers * 2, batch, hidden_size)\n        forward_hidden = hidden[-2]\n        backward_hidden = hidden[-1]\n\n        combined_hidden = torch.cat((forward_hidden, backward_hidden), dim=1)\n\n        x = self.dropout(combined_hidden)\n\n        return self.fc(x)\n\n\n# Initialize model\nmodel = BanglaBERT_GRU(num_classes).to(device)\n\n# ============================================================\n# LOSS + OPTIMIZER\n# ============================================================\ncriterion = nn.CrossEntropyLoss(label_smoothing=0.1)\noptimizer = torch.optim.AdamW(model.parameters(), lr=2e-5, weight_decay=1e-3)\n\n\n# ============================================================\n# EVALUATION FUNCTION (ADD INFERENCE TIME)\n# ============================================================\n\ndef evaluate(loader):\n\n    model.eval()\n\n    preds, labels, probs = [], [], []\n    total_loss = 0\n\n    start_inf = time.time()\n\n    with torch.no_grad():\n\n        for batch in loader:\n\n            input_ids = batch[\"input_ids\"].to(device)\n            attention_mask = batch[\"attention_mask\"].to(device)\n            y = batch[\"labels\"].to(device)\n\n            logits = model(input_ids, attention_mask)\n\n            loss = criterion(logits, y)\n            total_loss += loss.item()\n\n            probabilities = torch.softmax(logits, dim=1)\n\n            probs.extend(probabilities.cpu().numpy())\n            preds.extend(torch.argmax(logits, dim=1).cpu().numpy())\n            labels.extend(y.cpu().numpy())\n\n    total_inference_time = time.time() - start_inf\n\n    avg_time_per_sample = (total_inference_time / len(labels)) * 1000  \n\n    acc = accuracy_score(labels, preds)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(\n        labels, preds, average=\"weighted\"\n    )\n\n    y_bin = label_binarize(labels, classes=list(range(num_classes)))\n\n    auc = roc_auc_score(\n        y_bin,\n        np.array(probs),\n        average=\"weighted\",\n        multi_class=\"ovr\"\n    )\n\n    avg_loss = total_loss /