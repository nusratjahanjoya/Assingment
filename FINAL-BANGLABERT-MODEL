support\nfrom sklearn.metrics import classification_report, roc_auc_score, confusion_matrix\n\nwarnings.filterwarnings(\"ignore\")\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# REPRODUCIBILITY\n# ============================================================\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\ntorch.cuda.manual_seed_all(SEED)\ntorch.backends.cudnn.deterministic = True\ntorch.backends.cudnn.benchmark = False\n\n# ============================================================\n# LOAD PRE-SPLIT DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f-15/train_f15.csv\")\nval_df   = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f-15/val_f15.csv\")\ntest_df  = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-symtom-test-train-val-f-15/test_f15.csv\")\n\nTEXT_COL = \"text\"\nLABEL_COL = \"label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# LABEL ENCODING (FIT ONLY ON TRAIN)\n# ============================================================\nle = LabelEncoder()\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nbangla_class_names = le.classes_\n\n# ============================================================\n# TOKENIZER\n# ============================================================\nMODEL_NAME = \"csebuetnlp/banglabert\"\ntokenizer = AutoTokenizer.from_pretrained(MODEL_NAME)\nMAX_LEN = 128\n\n# ============================================================\n# DATASET CLASS\n# ============================================================\nclass BanglaDataset(Dataset):\n    def __init__(self, texts, labels):\n        self.texts = texts.tolist()\n        self.labels = labels.tolist()\n\n    def __len__(self):\n        return len(self.texts)\n\n    def __getitem__(self, idx):\n        enc = tokenizer(\n            self.texts[idx],\n            padding=\"max_length\",\n            truncation=True,\n            max_length=MAX_LEN,\n            return_tensors=\"pt\"\n        )\n\n        return {\n            \"input_ids\": enc[\"input_ids\"].squeeze(0),\n            \"attention_mask\": enc[\"attention_mask\"].squeeze(0),\n            \"labels\": torch.tensor(self.labels[idx], dtype=torch.long)\n        }\n\n# Train loader (shuffle=True)\ntrain_loader = DataLoader(\n    BanglaDataset(train_df[TEXT_COL], train_df[\"label_id\"]),\n    batch_size=32, shuffle=True\n)\n\n\ntrain_eval_loader = DataLoader(\n    BanglaDataset(train_df[TEXT_COL], train_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\nval_loader = DataLoader(\n    BanglaDataset(val_df[TEXT_COL], val_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\ntest_loader = DataLoader(\n    BanglaDataset(test_df[TEXT_COL], test_df[\"label_id\"]),\n    batch_size=32, shuffle=False\n)\n\n# ============================================================\n# MODEL (BanglaBERT + RNN)\n# ============================================================\nclass BanglaBERT_RNN(nn.Module):\n    def __init__(self, num_classes):\n        super().__init__()\n\n        self.bert = AutoModel.from_pretrained(MODEL_NAME)\n\n        # Freeze most layers\n        for param in self.bert.parameters():\n            param.requires_grad = False\n\n        # Unfreeze last 2 layers\n        for name, param in self.bert.named_parameters():\n            if \"encoder.layer.10\" in name or \"encoder.layer.11\" in name:\n                param.requires_grad = True\n\n        hidden_size = self.bert.config.hidden_size\n\n        # 🔹 RNN Layer (BiLSTM)\n        self.lstm = nn.LSTM(\n            input_size=hidden_size,\n            hidden_size=256,\n            num_layers=1,\n            batch_first=True,\n            bidirectional=True\n        )\n\n        # 🔹 Dropout\n        self.dropout = nn.Dropout(0.4)\n\n       \n        self.fc = nn.Linear(256 * 2, num_classes)  \n\n    def forward(self, input_ids, attention_mask):\n\n        outputs = self.bert(\n            input_ids=input_ids,\n            attention_mask=attention_mask\n        )\n\n        sequence_output = outputs.last_hidden_state  \n\n        \n        lstm_out, _ = self.lstm(sequence_output)\n\n       \n        last_hidden = lstm_out[:, -1, :]\n\n        x = self.dropout(last_hidden)\n\n        return self.fc(x)\n\n\n# Initialize model\nmodel = BanglaBERT_RNN(num_classes).to(device)\n\n# ============================================================\n# LOSS + OPTIMIZER\n# ============================================================\ncriterion = nn.CrossEntropyLoss(label_smoothing=0.1)\noptimizer = torch.optim.AdamW(model.parameters(), lr=2e-5, weight_decay=1e-3)\n\n\n# ============================================================\n# EVALUATION FUNCTION (ADD INFERENCE TIME)\n# ============================================================\n\ndef evaluate(loader):\n\n    model.eval()\n\n    preds, labels, probs = [], [], []\n    total_loss = 0\n\n    start_inf = time.time()\n\n    with torch.no_grad():\n\n        for batch in loader:\n\n            input_ids = batch[\"input_ids\"].to(device)\n            attention_mask = batch[\"attention_mask\"].to(device)\n            y = batch[\"labels\"].to(device)\n\n            logits = model(input_ids, attention_mask)\n\n            loss = criterion(logits, y)\n            total_loss += loss.item()\n\n            probabilities = torch.softmax(logits, dim=1)\n\n            probs.extend(probabilities.cpu().numpy())\n            preds.extend(torch.argmax(logits, dim=1).cpu().numpy())\n            labels.extend(y.cpu().numpy())\n\n    total_inference_time = time.time() - start_inf\n\n    avg_time_per_sample = (total_inference_time / len(labels)) * 1000  \n\n    acc = accuracy_score(labels, preds)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(\n        labels, preds, average=\"weighted\"\n    )\n\n    y_bin = label_binarize(labels, classes=list(range(num_classes)))\n\n    auc = roc_auc_score(\n        y_bin,\n        np.array(probs),\n        average=\"weighted\",\n        multi_class=\"ovr\"\n    )\n\n    avg_loss = total_loss / len(loader)\n\n    return acc, pr, rc, f1, auc, avg_loss, preds, labels, avg_time_per_sample, total_inference_time\n    \n# ============================================================\n# TRAINING\n# ============================================================\nEPOCHS = 20\nbest_val_loss = float(\"inf\")\nbest_state = None\n\nstart_time = time.time()\n\n# ============================================================\n# EARLY STOPPING SETTINGS\n# ============================================================\nPATIENCE = 3\ncounter = 0\n\nfor epoch in range(EPOCHS):\n    model.train()\n    total_loss = 0\n\n    for batch in train_loader:\n        optimizer.zero_grad()\n\n        input_ids = batch[\"input_ids\"].to(device)\n        attention_mask = batch[\"attention_mask\"].to(device)\n        labels = batch[\"labels\"].to(device)\n\n        logits = model(input_ids, attention_mask)\n        loss = criterion(logits, labels)\n        loss.backward()\n\n        torch.nn.utils.clip_grad_norm_(model.parameters(), 1.0)\n        optimizer.step()\n\n        total_loss += loss.item()\n\n    train_loss = total_loss / len(train_loader)\n\n    val_acc, val_pr, val_rc, val_f1, val_auc, val_loss, _, _, _, _ = evaluate(val_loader)\n\n    print(f\"Epoch {epoch+1}/{EPOCHS} | \"\n          f\"Train Loss: {train_loss:.4f} | \"\n          f\"Val Loss: {val_loss:.4f} | \"\n          f\"Val Acc: {val_acc:.4f} | \"\n          f\"Val F1: {val_f1:.4f}\")\n\n    # ===== EARLY STOPPING LOGIC =====\n    if val_loss < best_val_loss:\n        best_val_loss = val_loss\n        best_state = model.state_dict()\n        counter = 0  # reset counter\n    else:\n        counter += 1\n        print(f\"EarlyStopping Counter: {counter}/{PATIENCE}\")\n\n        if counter >= PATIENCE:\n            print(\"⛔ Early stopping triggered\")\n            break\n\n# ============================================================\n# TRAINING TIME + RAM USAGE CALCULATION (FIX)\n# ============================================================\ntraining_time = time.time() - start_time\nram_used = process.memory_info().rss / (1024 * 1024)  # in MB\n\n# ============================================================\n# FINAL EVALUATION\n# ============================================================\ntr = evaluate(train_eval_loader)\nva = evaluate(val_loader)\nte = evaluate(test_loader)\n\n# ============================================================\n# PERFORMANCE TABLE\n# ============================================================\nresults = pd.DataFrame({\n\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n\n    \"Accuracy\": [tr[0], va[0], te[0]],\n    \"Precision\": [tr[1], va[1], te[1]],\n    \"Recall\": [tr[2], va[2], te[2]],\n    \"F1-score\": [tr[3], va[3], te[3]],\n    \"Loss\": [tr[5], va[5], te[5]],\n    \"AUC\": [tr[4], va[4], te[4]],\n\n    \"Inference Time per Sample (ms)\": [\n        tr[8],\n        va[8],\n        te[8]\n    ],\n\n    \"Total Inference Time (sec)\": [\n        tr[9],\n        va[9],\n        te[9]\n    ],\n\n    \"Training Time (sec)\": [training_time]*3,\n    \"RAM Used (MB)\": [ram_used]*3\n})\n\nprint(\"\\n===== INFERENCE TIME =====\")\n\nprint(f\"Train  - Total: {tr[9]:.4f} sec | Avg/sample: {tr[8]:.4f} ms\")\nprint(f\"Val    - Total: {va[9]:.4f} sec | Avg/sample: {va[8]:.4f} ms\")\nprint(f\"Test   - Total: {te[9]:.4f} sec | Avg/sample: {te[8]:.4f} ms\")\n\nprint(\"\\n===== FINAL PERFORMANCE TABLE =====\")\nprint(results.round(4))\n# ============================================================\n# TERMINAL STYLE PREDICTION\n# ============================================================\ndef predict_disease_terminal(text):\n\n    model.eval()\n\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", str(text))\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n\n    encoding = tokenizer(\n        text,\n        padding=\"max_length\",\n        truncation=True,\n        max_length=MAX_LEN,\n        return_tensors=\"pt\"\n    )\n\n    with torch.no_grad():\n        outputs = model(\n            encoding[\"input_ids\"].to(device),\n            encoding[\"attention_mask\"].to(device)\n        )\n        probabilities = torch.softmax(outputs, dim=1).cpu().numpy()[0]\n\n    results_pred = pd.DataFrame({\n        \"Disease Name\": bangla_class_names,\n        \"Probability\": probabilities\n    }).sort_values(by=\"Probability\", ascending=False).reset_index(drop=True)\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"🩺 DISEASE PREDICTION RESULT\")\n    print(\"=\"*60)\n\n    print(\"\\n🔹 Input Symptoms:\")\n    print(text)\n\n    print(\"\\n🔹 Top Prediction:\")\n    print(f\" {results_pred.iloc[0]['Disease Name']}\")\n    print(f\" Confidence: {results_pred.iloc[0]['Probability']*100:.2f}%\")\n\n    return results_pred\n\n# ============================================================\n# RUN SAMPLE PREDICTIONS (Test Set)\n# ============================================================\nsamples = [\n    \n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে। আমার বুকে মাঝে মাঝে সারা রাত ব্যথা হয়, এবং আমি মাঝে মাঝে অসুস্থ বোধ করি।\",\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে। এমন কিছু অঞ্চলও রয়েছে যেগুলি আমার ত্বকের বাকি অংশের চেয়ে বেশি গাঢ় রঙের, এবং আমার কিছু বেদনাদায়ক পিণ্ড রয়েছে।\",\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না। আমার বুকে ব্যাথা হয় এবং আমার হৃদয় মনে হয় যেন আমি কাশির সময় ঘন্টায় এক মিলিয়ন মাইল বেগে দৌড়াচ্ছে। আমি একটি খারাপ মরিচা কফ আউট কাশি করছি.\",\n    \"আমি খুব বমি বমি ভাব অনুভব করি এবং বুকে ব্যথা অনুভব করি। সম্প্রতি আমি বুকে ব্যথা অনুভব করছি। আমি খুব অস্বস্তি বোধ করি এবং প্রায়শই প্রচুর ঘাম হয়\",\n    \"আমি যখন ঘুম থেকে উঠি তখন আমি প্রায়শই একটি খোঁচা কণ্ঠস্বর বা ব্যথাযুক্ত গলা পাই। আমার নিঃশ্বাসে দুর্গন্ধ এবং ক্রমাগত গলা ব্যথা হচ্ছে। আমারও অনেক বমি হয়।\",\n    \"আমি ওজন হারাচ্ছি, সত্যিই ক্লান্ত বোধ করছি, এবং অনেক বেশি নিক্ষেপ করছি। আমার ত্বক হলুদ হয়ে গেছে, এবং আমার প্রচণ্ড জ্বর হয়েছে। আমার গাঢ় প্রস্রাব হয়েছে, এবং আমার পেটে ব্যথা হচ্ছে।\",\n    \"আমি যে পেশীর ব্যথা অনুভব করছি তা গুরুতর এবং একটি ধ্রুবক ব্যথার মতো অনুভব করে। আমার সারা শরীরে লাল দাগ আছে এবং চুলকানির কারণে আমার খুব অস্বস্তি হচ্ছে।\",\n    \"আমার ঘাড় অত্যন্ত শক্ত হয়েছে এবং আমার পেশী অত্যন্ত দুর্বল হয়েছে। আমার জয়েন্টে ফুলে যাওয়ার ফলে, শক্ত অনুভব না করে চলাফেরা করতে আমার অসুবিধা হয়। উপরন্তু, হাঁটা অত্যন্ত অস্বস্তিকর হয়েছে.\",\n    \"আজ সকালে, আমি বুঝতে পারি যে আমার সারা শরীরে একটি বড় ফুসকুড়ি হয়েছে। যত্রতত্র পুঁজ এবং ব্ল্যাকহেডস ভরা প্রচুর ব্রণ রয়েছে এবং আমার ত্বক অনেক বেশি ঘা হয়ে গেছে।\"\n    \n]\n\nfor s in samples:\n    predict_disease_terminal(s)\n\n# ============================================================\n# NORMALIZED CONFUSION MATRIX\n# ============================================================\ny_true = te[7]\ny_pred = te[6]\n\ncm = confusion_matrix(y_true, y_pred)\ncm_normalized = cm.astype(\"float\") / cm.sum(axis=1)[:, np.newaxis]\n\nplt.figure(figsize=(14, 12))\nsns.heatmap(\n    cm_normalized,\n    annot=True,\n    fmt=\".2f\",\n    cmap=\"viridis\"\n)\nplt.title(\"Normalized Confusion Matrix\\nBanglaBERT + RNN\", fontsize=16)\nplt.xlabel(\"Predicted Label\")\nplt.ylabel(\"True Label\")\nplt.xticks(rotation=90)\nplt.yticks(rotation=0)\nplt.tight_layout()\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-18T05:30:35.876337Z","iopub.execute_input":"2026-04-18T05:30:35.876633Z","iopub.status.idle":"2026-04-18T05:51:01.382845Z","shell.execute_reply.started":"2026-04-18T05:30:35.876607Z","shell.execute_reply":"2026-04-18T05:51:01.381999Z"}},"outputs":[{"output_type":"display_data","data":{"text/plain":"Loading weights:   0%|          | 0/197 [00:00<?, ?it/s]","application/vnd.jupyter.widget-view+json":{"version_major":2,"version_minor":0,"model_id":"cee6f523c6d34f69b8e3093e3fb8be5a"}},"metadata":{}},{"name":"stderr","text":"ElectraModel LOAD REPORT from: csebuetnlp/banglabert\nKey                                               | Status     |  | \n--------------------------------------------------+------------+--+-\ndiscriminator_predictions.dense.weight            | UNEXPECTED |  | \nelectra.embeddings.position_ids                   | UNEXPECTED |  | \ndiscriminator_predictions.dense.bias              | UNEXPECTED |  | \ndiscriminator_predictions.dense_prediction.bias   | UNEXPECTED |  | \ndiscriminator_predictions.dense_prediction.weight | UNEXPECTED |  | \n\nNotes:\n- UNEXPECTED\t:can be ignored when loading from different task/architecture; not ok if you expect identical arch.\n","output_type":"stream"},{"name":"stdout","text":"Epoch 1/20 | Train Loss: 2.7620 | Val Loss: 2.6416 | Val Acc: 0.2889 | Val F1: 0.1830\nEpoch 2/20 | Train Loss: 1.7133 | Val Loss: 1.9605 | Val Acc: 0.5333 | Val F1: 0.4533\nEpoch 3/20 | Train Loss: 1.1614 | Val Loss: 1.5378 | Val Acc: 0.6889 | Val F1: 0.6309\nEpoch 4/20 | Train Loss: 0.9166 | Val Loss: 1.2692 | Val Acc: 0.7778 | Val F1: 0.7528\nEpoch 5/20 | Train Loss: 0.7940 | Val Loss: 1.0