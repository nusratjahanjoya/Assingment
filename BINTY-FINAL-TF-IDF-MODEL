=========================================================\nimport pandas as pd\nimport numpy as np\nimport re\nimport torch\nimport torch.nn as nn\nimport warnings\nimport matplotlib.pyplot as plt\nimport seaborn as sns\nimport time\nimport psutil\nimport os\nimport random\n\nfrom sklearn.feature_extraction.text import TfidfVectorizer\nfrom sklearn.preprocessing import LabelEncoder, label_binarize\nfrom sklearn.metrics import accuracy_score, precision_recall_fscore_support\nfrom sklearn.metrics import roc_auc_score, confusion_matrix\nfrom torch.utils.data import Dataset, DataLoader\n\nwarnings.filterwarnings(\"ignore\")\n\ndevice = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\nprocess = psutil.Process(os.getpid())\n\n# ============================================================\n# REPRODUCIBILITY\n# ============================================================\nSEED = 42\nrandom.seed(SEED)\nnp.random.seed(SEED)\ntorch.manual_seed(SEED)\n\n# ============================================================\n# LOAD DATA\n# ============================================================\ntrain_df = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-disease-dataset/train_f15.csv\")\nval_df   = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-disease-dataset/val_f15.csv\")\ntest_df  = pd.read_csv(\"/kaggle/input/datasets/mstnusratjahanjoya/translated-bangla-disease-dataset/test_f15.csv\")\n\nTEXT_COL = \"text\"\nLABEL_COL = \"label\"\n\n# ============================================================\n# CLEAN TEXT\n# ============================================================\ndef clean_text(text):\n    text = str(text)\n    text = re.sub(r\"http\\S+|www\\S+\", \"\", text)\n    text = re.sub(r\"\\s+\", \" \", text).strip()\n    return text\n\nfor df in [train_df, val_df, test_df]:\n    df[TEXT_COL] = df[TEXT_COL].apply(clean_text)\n    df.dropna(inplace=True)\n    df.drop_duplicates(inplace=True)\n\n# ============================================================\n# TF-IDF VECTORIZE\n# ============================================================\ntfidf = TfidfVectorizer(max_features=5000)\n\nX_train = tfidf.fit_transform(train_df[TEXT_COL]).toarray()\nX_val   = tfidf.transform(val_df[TEXT_COL]).toarray()\nX_test  = tfidf.transform(test_df[TEXT_COL]).toarray()\n\nINPUT_DIM = X_train.shape[1]\n\n# ============================================================\n# LABEL ENCODING\n# ============================================================\nle = LabelEncoder()\ntrain_df[\"label_id\"] = le.fit_transform(train_df[LABEL_COL])\nval_df[\"label_id\"]   = le.transform(val_df[LABEL_COL])\ntest_df[\"label_id\"]  = le.transform(test_df[LABEL_COL])\n\nnum_classes = len(le.classes_)\nclass_names = le.classes_\n\n# ============================================================\n# DATASET\n# ============================================================\nclass TFIDFDataset(Dataset):\n    def __init__(self, X, y):\n        self.X = torch.tensor(X, dtype=torch.float32)\n        self.y = torch.tensor(y.values, dtype=torch.long)\n\n    def __len__(self):\n        return len(self.y)\n\n    def __getitem__(self, idx):\n        return {\n            \"input\": self.X[idx],\n            \"label\": self.y[idx]\n        }\n\ntrain_loader = DataLoader(TFIDFDataset(X_train, train_df[\"label_id\"]), batch_size=32, shuffle=True)\nval_loader   = DataLoader(TFIDFDataset(X_val, val_df[\"label_id\"]), batch_size=32, shuffle=False)\ntest_loader  = DataLoader(TFIDFDataset(X_test, test_df[\"label_id\"]), batch_size=32, shuffle=False)\n\n# ============================================================\n# MODEL: TF-IDF + Random Forest\n# ============================================================\nfrom sklearn.ensemble import RandomForestClassifier\n\nmodel = RandomForestClassifier(\n    n_estimators=300,\n    random_state=SEED,\n    n_jobs=-1\n)\n\n# ============================================================\n# TRAINING\n# ============================================================\nstart_time = time.time()\n\nmodel.fit(X_train, train_df[\"label_id\"])\n\ntraining_time = time.time() - start_time\n\n# ============================================================\n# EVALUATION FUNCTION\n# ============================================================\ndef evaluate_ml(model, X, y_true):\n\n    start_inference = time.time()\n\n    y_pred = model.predict(X)\n    y_prob = model.predict_proba(X)\n\n    total_inference_time = time.time() - start_inference\n\n    avg_inference_time = (\n        total_inference_time / len(y_true)\n    ) * 1000\n\n    acc = accuracy_score(y_true, y_pred)\n\n    pr, rc, f1, _ = precision_recall_fscore_support(\n        y_true,\n        y_pred,\n        average=\"weighted\"\n    )\n\n    y_bin = label_binarize(\n        y_true,\n        classes=list(range(num_classes))\n    )\n\n    auc = roc_auc_score(\n        y_bin,\n        y_prob,\n        average=\"weighted\",\n        multi_class=\"ovr\"\n    )\n\n    return (\n        acc,\n        pr,\n        rc,\n        f1,\n        auc,\n        y_pred,\n        avg_inference_time,\n        total_inference_time\n    )\n\n\n# ============================================================\n# FINAL EVALUATION\n# ============================================================\ntr = evaluate_ml(\n    model,\n    X_train,\n    train_df[\"label_id\"]\n)\n\nva = evaluate_ml(\n    model,\n    X_val,\n    val_df[\"label_id\"]\n)\n\nte = evaluate_ml(\n    model,\n    X_test,\n    test_df[\"label_id\"]\n)\n\nram_used = process.memory_info().rss / (1024 * 1024)\n\n# ============================================================\n# PERFORMANCE TABLE\n# ============================================================\nresults = pd.DataFrame({\n\n    \"Dataset\": [\"Train\", \"Validation\", \"Test\"],\n\n    \"Accuracy\": [tr[0], va[0], te[0]],\n\n    \"Precision\": [tr[1], va[1], te[1]],\n\n    \"Recall\": [tr[2], va[2], te[2]],\n\n    \"F1-score\": [tr[3], va[3], te[3]],\n\n    \"AUC\": [tr[4], va[4], te[4]],\n\n    \"Inference Time per Sample (ms)\": [\n        tr[6],\n        va[6],\n        te[6]\n    ],\n\n    \"Total Inference Time (sec)\": [\n        tr[7],\n        va[7],\n        te[7]\n    ],\n\n    \"Training Time (sec)\": [training_time] * 3,\n\n    \"RAM Used (MB)\": [ram_used] * 3\n})\n\n# ============================================================\n# PRINT RESULTS\n# ============================================================\nprint(\"\\n===== FINAL PERFORMANCE TABLE =====\")\n\nprint(results.round(4))\n\nprint(\"\\n===== INFERENCE TIME =====\")\n\nprint(\n    f\"Train  - Total: {tr[7]:.4f} sec | \"\n    f\"Avg/sample: {tr[6]:.4f} ms\"\n)\n\nprint(\n    f\"Val    - Total: {va[7]:.4f} sec | \"\n    f\"Avg/sample: {va[6]:.4f} ms\"\n)\n\nprint(\n    f\"Test   - Total: {te[7]:.4f} sec | \"\n    f\"Avg/sample: {te[6]:.4f} ms\"\n)\n\n# ============================================================\n# PREDICTION FUNCTION\n# ============================================================\ndef predict_disease_terminal(text):\n\n    text = clean_text(text)\n\n    vec = tfidf.transform([text]).toarray()\n\n    probs = model.predict_proba(vec)[0]\n\n    df = pd.DataFrame({\n        \"Disease Name\": class_names,\n        \"Probability\": probs\n    }).sort_values(by=\"Probability\", ascending=False)\n\n    print(\"\\n\" + \"=\"*60)\n    print(\"🩺 DISEASE PREDICTION RESULT\")\n    print(\"=\"*60)\n\n    print(\"\\n🔹 Input Symptoms:\")\n    print(text)\n\n    print(\"\\n🔹 Top Prediction:\")\n    print(df.iloc[0][\"Disease Name\"])\n\n    print(\n        f\"Confidence: \"\n        f\"{df.iloc[0]['Probability']*100:.2f}%\"\n    )\n\n    return df\n\n\n# ============================================================\n# RUN SAMPLE PREDICTIONS (Test Set)\n# ============================================================\nsamples = [\n    \n    \"আমি অস্বস্তিকর, অসুস্থ এবং টলমল বোধ করি। আমার গলা বড় হয়ে গেছে এবং আমার শ্বাস নিতে কষ্ট হচ্ছে। আমার বুকে মাঝে মাঝে সারা রাত ব্যথা হয়, এবং আমি মাঝে মাঝে অসুস্থ বোধ করি।\",\n    \"আমি সম্প্রতি বেশ চুলকায়, এবং আমার সমস্ত ত্বকে ফুসকুড়ি দাগ রয়েছে। এমন কিছু অঞ্চলও রয়েছে যেগুলি আমার ত্বকের বাকি অংশের চেয়ে বেশি গাঢ় রঙের, এবং আমার কিছু বেদনাদায়ক পিণ্ড রয়েছে।\",\n    \"আমি ঠাণ্ডা অনুভব করছি, ক্লান্ত বোধ করছি, এবং আমি এই কাশি কাঁপতে পারছি না। আমার বুকে ব্যাথা হয় এবং আমার হৃদয় মনে হয় যেন আমি কাশির সময় ঘন্টায় এক মিলিয়ন মাইল বেগে দৌড়াচ্ছে। আমি একটি খারাপ মরিচা কফ আউট কাশি করছি.\",\n    \"আমি খুব বমি বমি ভাব অনুভব করি এবং বুকে ব্যথা অনুভব করি। সম্প্রতি আমি বুকে ব্যথা অনুভব করছি। আমি খুব অস্বস্তি বোধ করি এবং প্রায়শই প্রচুর ঘাম হয়\",\n    \"আমি যখন ঘুম থেকে উঠি তখন আমি প্রায়শই একটি খোঁচা কণ্ঠস্বর বা ব্যথাযুক্ত গলা পাই। আমার নিঃশ্বাসে দুর্গন্ধ এবং ক্রমাগত গলা ব্যথা হচ্ছে। আমারও অনেক বমি হয়।\",\n    \"আমি ওজন হারাচ্ছি, সত্যিই ক্লান্ত বোধ করছি, এবং অনেক বেশি নিক্ষেপ করছি। আমার ত্বক হলুদ হয়ে গেছে, এবং আমার প্রচণ্ড জ্বর হয়েছে। আমার গাঢ় প্রস্রাব হয়েছে, এবং আমার পেটে ব্যথা হচ্ছে।\",\n    \"আমি যে পেশীর ব্যথা অনুভব করছি তা গুরুতর এবং একটি ধ্রুবক ব্যথার মতো অনুভব করে। আমার সারা শরীরে লাল দাগ আছে এবং চুলকানির কারণে আমার খুব অস্বস্তি হচ্ছে।\",\n    \"আমার ঘাড় অত্যন্ত শক্ত হয়েছে এবং আমার পেশী অত্যন্ত দুর্বল হয়েছে। আমার জয়েন্টে ফুলে যাওয়ার ফলে, শক্ত অনুভব না করে চলাফেরা করতে আমার অসুবিধা হয়। উপরন্তু, হাঁটা অত্যন্ত অস্বস্তিকর হয়েছে.\",\n    \"আজ সকালে, আমি বুঝতে পারি যে আমার সারা শরীরে একটি বড় ফুসকুড়ি হয়েছে। যত্রতত্র পুঁজ এবং ব্ল্যাকহেডস ভরা প্রচুর ব্রণ রয়েছে এবং আমার ত্বক অনেক বেশি ঘা হয়ে গেছে।\"\n    \n]\n\nfor s in samples:\n    predict_disease_terminal(s)\n\n\n# ============================================================\n# NORMALIZED CONFUSION MATRIX\n# ============================================================\ny_true = test_df[\"label_id\"]\ny_pred = te[5]\n\ncm = confusion_matrix(y_true, y_pred)\n\ncm_normalized = cm.astype(\"float\") / cm.sum(axis=1)[:, np.newaxis]\n\nplt.figure(figsize=(14, 12))\n\nsns.heatmap(\n